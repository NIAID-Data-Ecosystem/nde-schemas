          "coordinates": {
            "@type": "GeoCoordinates",
            "description": "The geographic coordinates of a place",
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              },
              "elevation": {
                "type": "string"
              }
            }
          },
          "adminarea": {
            "@type": "AdministrativeArea",
            "type": "object",
            "description": "Location information",
            "properties": {
              "administrativeType": {
                "description": "the type of administrative area, such as country, state, county, or city",
                "abstract": "The type of geographic area defined by how it is administered or governed",
                "alternateName": "Administrative Type",
                "disambiguatingDescription": "Province: a large administrative division of a country, often with its own regional government; District: a subdivision of a province, state, or region used for local administration; Chiefdom: a territory ruled by a traditional chief, common in parts of West Africa; Village: a small rural community, usually smaller than a town; City: a large, densely populated urban area with its own local government; Country: a sovereign nation with its own government and defined borders; Prefecture: an administrative division headed by a prefect, used in places like Japan, France, and Guinea; Sub-prefecture: a smaller administrative unit within a prefecture; Clan: a group of families who share a common ancestor or heritage; Federal Capital Territory: a special area, such as Abuja in Nigeria, that serves as the national capital and isn’t part of any state; State: a self-governing region within a federal country, such as Nigeria or the United States; Local Government Area: the third tier of government in Nigeria, similar to a county or municipality; Ward: the smallest electoral or administrative unit within a local government area or city; Region: a broad area defined by geography, culture, or administration, often larger than a district; Continent: one of Earth’s seven major landmasses, such as Africa or Asia; Military installation: a facility or base used by armed forces for operations, training, or housing; Other: any location type that doesn’t fit the categories listed above.",
                "enum": ["province", "district", "chiefdom", "village", "city", "country", "prefecture", "sub-prefecture", "clan", "Federal Capital Territory", "state", "Local Government Area", "ward", "region", "continent", "military installation", "other"],
                "type": "string"
              },
              "alternateName": {
                "description": "An alias for the location",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "identifier": {
                "description": "An identifier for the location, preferably a Wikidata ID",
                "abstract": "A unique ID for the Place",
                "alternateName": "Identifier",
                "type": "string"
              },
              "locationType": {
                "description": "Categorization of how the location relates to the dataset",
                "abstract": "How the location relates to the resource",
                "alternateName": "Location Type",
                "disambiguatingDescription": "Residence: the subjects reside in the geographic area; Exposure: the subjects were exposed to a disease-causing agent in the geographic area; Collection: the data or samples were collected in the geographic area; Treatment: the subjects or samples were treated in the geographic area; Study location: the study was conducted in the geographic area; Item location: the sample or item is located in the geographic area; Other: there is a different relationship between the geographic area and the resource; Unknown: the relationship between the geographic area and the resource is not known",
                "oneOf": [
                  {
                    "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "name": {
                "description": "The name of the location",
                "abstract": "The full official name of the Place",
                "alternateName": "Name",
                "type": "string"
              },
              "geo": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/coordinates"
                    }
                  },
                  {
                      "$ref": "#/definitions/coordinates"
                  }
                ]
                  }
            }
          }
        }
      }
    },
    {
      "@id": "nde:DefinedTerm",
      "@type": "rdfs:Class",
      "rdfs:comment": "A word, name, acronym, phrase, etc. with a formal definition. Often used in the context of category or subject classification, glossaries or dictionaries, product or creative work types, etc. Use the name property for the term being defined, use termCode if the term has an alpha-numeric code allocated, use description to provide the definition of the term.",
      "rdfs:label": "DefinedTerm",
      "rdfs:subClassOf": {
        "@id": "schema:DefinedTerm"
      },
      "schema:schemaVersion":["https://schema.org/docs/releases.html#v18.0","v1.3 - 2026.11.18"],
      "dct:provenance":"Changes since previous version: Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Drop 'title' from reusable Person objects, drop 'affiliation' from reusable Organization objects, add 'identifier' to DataCatalog objects for 'includedInDataCatalog'.",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "description": "The name of the item.",
            "abstract": "The full official name of the item",
            "alternateName": "Name",
            "owl:cardinality": "one",
            "type": "string"
          },
          "identifier": {
            "description": "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See background notes for more details.",
            "abstract": "A unique ID for the resource",
            "alternateName": "Identifier",
            "owl:cardinality": "one",
            "type": "string"           
          },
          "url": {
            "description": "URL of the item.",
            "abstract": "The main website URL of the item",
            "alternateName": "URL",
            "owl:cardinality": "one",
            "type": "string",
            "format": "uri"
          },
          "curatedBy": {
            "description": "The person, organization, or catalog that curated this DefinedTerm for the metadata property",
            "abstract": "Human(s) or automated algorithm(s) that curated the resource or its metadata",
            "alternateName": "Curated By",
            "anyOf": [
              {
                "$ref": "#/definitions/person"
              },
              {
                "$ref": "#/definitions/organization"
              },
              {
                "$ref": "#/definitions/catalog"
              },
              {
                "$ref": "#/definitions/researchproject"
              },
              {
                "$ref": "#/definitions/softwareapplication"
              }
            ]
          },
          "termCode": {
            "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
            "abstract": "The code for the term in its source ontology",
            "alternateName": "Term Code",
            "type": "string"
          },
          "description": {
            "description": "A description of the item.",
            "abstract" : "An overview of the item",
            "alternateName": "Description",
            "type": "string"
          },
          "inDefinedTermSet": {
            "description": "A DefinedTermSet that contains this term.",
            "abstract": "Ontology or controlled vocabulary from which the term comes",
            "alternateName": "Ontology",
            "type": "string"
          },
          "originalName": {
            "description": "The original name of the item, before any metadata standardization/normalization",
            "abstract": "The term as it appeared before standardization",
            "alternateName": "Original Name",
            "type": "string"
          },
          "isCurated": {
            "description": "A boolean indicator describing whether or not this DefinedTerm was curated as the value of a property.",
            "abstract": "Whether the information was reviewed by a curator",
            "alternateName": "Curated",
            "type": "boolean"
          }
        },
        "required": [],
        "recommended": [
          "description",
          "curatedBy",
          "isCurated"
        ],
        "optional": [
          "termCode",
          "inDefinedTermSet",
          "originalName"
        ],
        "anyOf": [
            {"required":["name"]},
            {"required":["identifier"]},
            {"required":["url"]}
        ],
        "definitions": {
          "catalog": {
            "@type": "DataCatalog",
            "description": "Data, resource or tool catalog",
            "type": "object",
            "properties": {
              "name": {
                "description": "Data, resource or tool catalog name",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier for the catalog within the Discovery Portal",
                "abstract": "The identifier of the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "Link to data, resource or tool catalog",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "versionDate": {
                "description": "date the metadata was harvested from the catalog",
                "abstract": "Date the version was released",
                "alternateName": "Version Date",
                "type": "string",
                "format": "date"
              },
              "archivedAt": {
                "description": "The url(s) of one or more datasets, tools, resources or other items listed in a DataCatalog or ResourceCatalog",
                "abstract": "Link to the resource metadata record at the original source",
                "alternateName": "Source URL", 
                "oneOf": [
                  {
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "type": "array"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": ["name", "url"],
            "recommended": ["identifier", "versionDate", "archivedAt"]
          },
          "organization": {
            "@type": "Organization",
            "description": "Reusable organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier"],
            "optional": ["alternateName", "email", "parentOrganization", "role", "url"],
            "type": "object"
          },
          "researchproject": {
            "@type": "ResearchProject",
            "description": "a type of organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier", "url", "parentOrganization"],
            "optional": ["alternateName", "email", "role"],
            "type": "object"
          },
          "person": {
            "@type": "Person",
            "description": "Reusable person definition",
            "properties": {
              "affiliation": {
                "abstract": "The person's institutional or organizational affiliation",
                "alternateName": "Affiliation",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name of the affiliation, such as a university",
                    "abstract": "The full official name of the affiliation",
                    "alternateName": "Name",
                    "type": "string"
                  },
                  "identifier": {
                    "description": "An identifier for the affiliation",
                    "abstract": "ID of the affiliation",
                    "alternateName": "Identifier",
                    "type": "string"
                  },
                  "url": {
                    "description": "URL of the affiliation",
                    "abstract": "The main website URL of the affiliation",
                    "alternateName": "URL",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["name"],
                "optional": ["identifier", "url"]
              },
              "name": {
                "description": "Name of the person",
                "abstract": "The name of the person",
                "alternateName": "Name",
                "type": "string"
              },
              "email": {
                "description": "Email address of the person",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "familyName": {
                "description": "Family name (surname) of the person",
                "abstract": "An individual's family name or surname",
                "alternateName": "Last Name",
                "type": "string"
              },
              "givenName": {
                "description": "Given (first) name of the person",
                "abstract": "An individual's given name",
                "alternateName": "First Name",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the person, like an ORCID ID",
                "abstract": "A unique ID for the person",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "Role the person played in creating the resource catalog",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the homepage or other web content describing the person",
                "abstract": "The main website URL of the person",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["familyName", "givenName", "identifier"],
            "optional": ["affiliation", "email", "role", "url"],
            "type": "object"
          },
          "softwareapplication": {
            "@type": "SoftwareApplication",
            "description": "Reusable software or algorithm definition",
            "properties": {
              "name": {
                "description": "name of the software, computational tool, or algorithm.",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "dateModified": {
                "description": "date the software, computational tool, or algorithm was run",
                "abstract": "Date the tool was most recently run",
                "alternateName": "Date Modified",
                "type": "string",
                "format": "date"
              },
              "url": {
                "description": "url of the software, computational tool, or algorithm",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["url"],
            "optional": ["dateModified"],
            "type": "object"
          }
        }
