            "type": "string"
          },
          "sameAs": {
            "description": "URL of additional sources for the work.",
            "abstract": "Links to the resource in other places",
            "alternateName": "Also Listed As",
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ],
            "owl:cardinality": "many"
          },
          "url": {
            "description": "URL of the work.",
            "abstract": "The main website URL of the resource",
            "alternateName": "URL",
            "type": "string",
            "format": "uri",
            "owl:cardinality": "one"
          },
          "collectionSize": {
            "description": "The number of records, datasets, tools, items, pages, etc. in the resource catalog. Min/max estimates can be used in lieu of actual number. If completely unknown, set value = 0, and unitText = 'unknown'",
            "abstract": "The number of items in the collection or resource",
            "alternateName": "Collection Size",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/quantitativevalue"
                }
              },
              {
                "$ref": "#/definitions/quantitativevalue"
              }    
            ],
            "owl:cardinality": "many"             
          },
          "collectionType": {
            "description": "The type of resource/resource catalog that best describes the work.",
            "abstract": "Categories that describe the resource, as classified by the Discovery Portal or others",
            "alternateName": "Resource Type",
            "anyOf": [
              {
                "type": "string",
                "enum": ["Dataset Repository", "Computational Tool Repository", "Data Repository", "Resource Catalog", "Sample Repository", "Program Repository", "Knowledge Base", "Ontology", "Terminology", "Database", "Dataset", "Metadata Catalog", "Archive", "Cloud Ecosystem", "Corpus", "Repository", "Controlled Vocabulary", "Registry", "Data Dictionary", "Data Mart", "Data Warehouse", "Data Store", "Data Collection", "Portal"]
              },
              {
                  "$ref": "#/definitions/collectiontypes"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/collectiontypes"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["Dataset Repository", "Computational Tool Repository", "Data Repository", "Resource Catalog", "Sample Repository", "Program Repository", "Knowledge Base", "Ontology", "Terminology", "Database", "Dataset", "Metadata Catalog", "Archive", "Cloud Ecosystem", "Corpus", "Repository", "Controlled Vocabulary", "Registry", "Data Dictionary", "Data Mart", "Data Warehouse", "Data Store", "Data Collection", "Portal"]
                }
              }
            ],
            "owl:cardinality": "many"
          },
          "sourceOrganization": {
            "description": "The organization, research project, working group, or funded program on whose behalf the author/creator was working.",
            "abstract": "The research network, project, center, program, etc. that created the resource",
            "alternateName": "Program Collection",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/researchproject"
                }
              },
              {
                  "$ref": "#/definitions/researchproject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/organization"
                }
              },
              {
                  "$ref": "#/definitions/organization"
              }
            ],
            "owl:cardinality": "many"
          },
          "archivedAt": {
            "description": "The url(s) of one or more datasets, tools, resources or other items listed in a DataCatalog or ResourceCatalog",
            "abstract": "Link to the resource metadata record at the original source",
            "alternateName": "Source URL", 
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ],
            "owl:cardinality": "many"
          },
          "creditText": {
            "description": "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work. For example, how a user should cite the resource.",
            "abstract": "Citation or acknowledgment text the resource asks users to include when they use it",
            "alternateName": "How to Credit",
            "type": "string",
            "owl:cardinality": "one"
          },
          "creativeWorkStatus": {
            "description": "The status of the ResourceCatalog. Expected to be one of the following values: Draft (The resources is under development), Active (The resource is currently working and available), Maintenance (The resource is temporarily unavailable for maintenance), Accepting Data (The resource is Active AND Accepting submissions), Not Accepting Data (The resource is Active but is NOT Accepting submissions), Retired (The resource is no longer available).",
            "abstract": "Status of the resource: Active, Accepting Data, Not Accepting Data, Maintenance, Draft, or Retired",
            "alternateName": "Status",
            "disambiguatingDescription": "Draft: Under development; Active: Currently working and available; Maintenance: Temporarily unavailable for maintenance; Accepting Data: Active AND Accepting submissions; Not Accepting Data: Active but is NOT Accepting submissions; Retired: No longer available).",
            "type": "string",
            "enum": ["Draft", "Active", "Maintenance", "Accepting Data", "Not Accepting Data", "Retired"],
            "owl:cardinality": "one"
          },
          "publishingPrinciples": {
            "description": "Information about the data submission standards or process for this resource including (but not limited to): standards (like CoreTrustSeal), submission form links, data submission description pages.",
            "abstract": "Information about the data submission standards or process for this resource",
            "alternateName": "Submission Guidelines", 
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }        
            ],
            "owl:cardinality": "many"
          }
        },
        "required": ["date", "funding", "measurementTechnique", "description", "name", "url", "about","genre", "includedInDataCatalog"],
        "recommended": ["author", "citedBy", "doi", "infectiousAgent", "healthCondition", "species", "variableMeasured", "citation", "conditionsOfAccess", "dateCreated", "dateModified", "datePublished", "interactionStatistic", "isBasedOn", "keywords", "license", "sdPublisher", "spatialCoverage", "temporalCoverage", "usageInfo", "identifier", "topicCategory", "collectionSize", "hasAPI", "hasDownload", "creditText", "collectionType","creativeWorkStatus", "publishingPrinciples"],
        "optional": ["isRelatedTo", "isSimilarTo", "isBasisFor", "distribution", "abstract", "aggregateRating", "creator", "hasPart", "inLanguage", "isAccessibleForFree", "isPartOf", "version", "alternateName", "mainEntityOfPage", "sameAs", "relationship", "sourceOrganization", "archivedAt"],
        "definitions": {
          "citationobject": {
            "description": "A citation object for a publication which is cited by the resource catalog (ie- is a derivative of the resource catalog), related to the resource catalog, or from which the resource catalog was based on (ie- is derived from).",
            "@type": "ScholarlyArticle",
            "type": "object",
            "properties": {
              "author": {
                "description": "Author(s) of the publication",
                "abstract": "Individual(s) or organization(s) who created the reference",
                "alternateName": "Author",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/person"
                    }
                  },
                  {
                      "$ref": "#/definitions/person"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/organization"
                    }
                  },
                  {
                      "$ref": "#/definitions/organization"
                  }
                ]
              },
              "abstract": {
                "description": "Abstract of the publication",
                "abstract": "A short summary of the reference",
                "alternateName": "Abstract",
                "type": "string"
              },
              "datePublished": {
                "description": "Date the article was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "description": {
                "description": "Description of the publication",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "name": {
                "description": "Title of the publication",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the citation such as a digital object identifier (DOI), PubMed ID (PMID), or PubMed Central ID (PMCID)",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "pmid": {
                "description": "A PubMed identifier (PMID) of the referenced publication",
                "abstract": "PubMed identifier (PMID) of the publication",
                "alternateName": "PubMed ID",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced publication",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "issueNumber": {
                "description": "Issue number where the article appears",
                "abstract": "Journal issue in which the publication appeared",
                "alternateName": "Issue Number",
                "type": "string"
              },
              "journalName": {
                "description": "Journal where the article appears",
                "abstract": "Name of the journal in which the reference appeared",
                "alternateName": "Journal",
                "type": "string"
              },
              "journalNameAbbrev": {
                "description": "Abbreviated journal name where the article appears",
                "abstract": "Abbreviation of the name of the journal in which the reference appeared",
                "alternateName": "Journal Abbreviation",
                "type": "string"
              },
              "pagination": {
                "description": "Page numbers in the journal where the article appears",
                "abstract": "Page range of the publication",
                "alternateName": "Pages",
                "type": "string"
              },
              "url": {
                "description": "The url of the article",
                "abstract": "The main website URL of the reference",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "volumeNumber": {
                "description": "Volume of the journal where the article appears",
                "abstract": "Volume of the journal where the publication appeared",
                "alternateName": "Volume Number",
                "type": "string"
              },
              "citation": {
                "description": "The bibliographic citation string for the article as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "datePublished", "doi", "identifier", "journalName", "pmid", "url"],
            "optional": ["abstract", "citation", "description", "issueNumber", "journalNameAbbrev", "pagination", "volumeNumber"]
          },
          "creativework": {
            "description": "A resource",
            "@type": "CreativeWork",
            "type": "object",
            "properties": {
              "author": {
                "description": "Author(s) of the referenced work",
                "abstract": "Individual(s) or organization(s) who created the reference",
                "alternateName": "Author",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/person"
                    }
                  },
                  {
                      "$ref": "#/definitions/person"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/organization"
                    }
                  },
                  {
                      "$ref": "#/definitions/organization"
                  }
                ]
              },
              "abstract": {
                "description": "Abstract of the referenced work",
                "abstract": "A short summary of the reference",
                "alternateName": "Abstract",
                "type": "string"
              },
              "datePublished": {
                "description": "Date the referenced work was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "additionalType": {
                "description": "Additional type of the referenced work, such as a Sample, Run, Experiment, etc.",
                "abstract": "More classifications for the resource or reference",
                "alternativeName": "Also Classified As",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "format": "uri",
                          "type": "string"
                        }
                      },
                      "required": ["name"],
                      "recommended": ["url"],
                      "type": "object",
                      "@type": "DefinedTerm"                
                    },
                    "type": "array"
                  },
                  {
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "format": "uri",
                        "type": "string"
                      }
                    },
                    "required": ["name"],
                    "recommended": ["url"],
                    "type": "object",
                    "@type": "DefinedTerm"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }    
                ]
              },
              "description": {
                "description": "Description of the referenced work",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "hasPart": {
                "description": "A portion of the work",
                "abstract": "Part(s) that make up the resource",
                "alternateName": "Component",
                "oneOf": [
                  {
                    "$ref": "#/definitions/citationobject"
                  }
                ]
              },
              "includedInDataCatalog": {
                "description": "Data, resource or tool catalog which houses the work",
                "abstract": "The repository or catalog where the resource is listed",
                "alternateName": "Source",
                "oneOf": [
                  {
                    "$ref": "#/definitions/catalog"
                  }
                ]
              },
              "name": {
                "description": "Name or title",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the work",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "relationship": {
                "description": "How the works are related",
                "abstract": "How the resource is related to another resource",
                "alternateName": "Relationship",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced work",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "url": {
                "description": "The url of the work",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "citation": {
                "description": "The bibliographic citation for the referenced work as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "datePublished", "doi", "identifier", "includedInDataCatalog", "relationship", "url", "additionalType"],
            "optional": ["abstract", "citation", "description", "hasPart"]
          },
          "topic": {
            "description": "Topic assigned to the work.",
            "type": "string",
            "vocabulary": {
              "ontology": ["edam"],
              "children_of": ["http://edamontology.org/topic_0003"]
            },
            "strict": true
          },
          "catalog": {
            "@type": "DataCatalog",
            "description": "Data, resource or tool catalog",
            "type": "object",
            "properties": {
              "name": {
                "description": "Data, resource or tool catalog name",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier for the catalog within the Discovery Portal",
                "abstract": "The identifier of the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "Link to data, resource or tool catalog",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "versionDate": {
                "description": "date the metadata was harvested from the catalog",
                "abstract": "Date the version was released",
                "alternateName": "Version Date",
                "type": "string",
                "format": "date"
              },
              "archivedAt": {
                "description": "The url(s) of one or more datasets, tools, resources or other items listed in a DataCatalog or ResourceCatalog",
                "abstract": "Link to the resource metadata record at the original source",
                "alternateName": "Source URL", 
                "oneOf": [
                  {
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "type": "array"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": ["name", "url"],
            "recommended": ["identifier", "versionDate", "archivedAt"]
          },
          "organization": {
            "@type": "Organization",
            "description": "Reusable organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier"],
            "optional": ["alternateName", "email", "parentOrganization", "role", "url"],
            "type": "object"
          },
          "researchproject": {
            "@type": "ResearchProject",
            "description": "a type of organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the resource",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier", "url", "parentOrganization"],
            "optional": ["alternateName", "email", "role"],
            "type": "object"
          },
          "person": {
            "@type": "Person",
            "description": "Reusable person definition",
            "properties": {
              "affiliation": {
                "abstract": "The person's institutional or organizational affiliation",
                "alternateName": "Affiliation",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name of the affiliation, such as a university",
                    "abstract": "The full official name of the affiliation",
                    "alternateName": "Name",
                    "type": "string"
                  },
                  "identifier": {
                    "description": "An identifier for the affiliation",
                    "abstract": "ID of the affiliation",
                    "alternateName": "Identifier",
                    "type": "string"
                  },
                  "url": {
                    "description": "URL of the affiliation",
                    "abstract": "The main website URL of the affilation",
                    "alternateName": "URL",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["name"],
                "optional": ["identifier", "url"]
              },
              "name": {
                "description": "Name of the person",
                "abstract": "The name of the person",
                "alternateName": "Name",
                "type": "string"
              },
              "email": {
                "description": "Email address of the person",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "familyName": {
                "description": "Family name (surname) of the person",
                "abstract": "An individual's family name or surname",
                "alternateName": "Last Name",
                "type": "string"
              },
              "givenName": {
                "description": "Given (first) name of the person",
                "abstract": "An individual's given name",
                "alternateName": "First Name",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the person, like an ORCID ID",
                "abstract": "A unique ID for the person",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "Role the person played in creating the resource catalog",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the homepage or other web content describing the person",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["familyName", "givenName", "identifier"],
            "optional": ["affiliation", "email", "role", "url"],
            "type": "object"
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be (1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3) a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry). Standards bodies should promote a standard prefix for the identifiers of properties from their standards.",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required" : ["unitText"],
            "recommended": ["value","propertyID"],
            "optional": ["maxValue","minValue"]
          },
          "quantitativevalue": {
            "@type": "QuantitativeValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              }
            },
            "required" : ["unitText"],
            "recommended": ["value"],
            "optional": ["maxValue","minValue"]
          },
          "collectiontypes": {
            "description": "potential ontology-linked resource types",
            "@type": "DefinedTerm",
            "type": "string",
            "vocabulary": {
              "ontology": ["ncit"],
              "children_of": ["http://purl.obolibrary.org/obo/NCIT_C16048"]
            },
            "strict": false
          },
          "definedterm": {
            "@type": "DefinedTerm",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
