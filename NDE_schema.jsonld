          "distribution": {
            "description": "A downloadable form of the resource catalog, at a specific location, in a specific format.",
            "abstract": "Downloadable copies of the resource",
            "alternateName": "File",
            "oneOf": [
              {
                "items": {
                  "@type": "DataDownload",
