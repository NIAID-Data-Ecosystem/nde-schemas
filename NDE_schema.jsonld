          "conditionsOfAccess": {
            "description": "Conditions that affect the availability of, or method(s) of access to the source records included in the data collection. Options include open (freely available), restricted (may include restrictions such as on use), closed (requires registration to access), or embargoed (unpublished).",
            "abstract": "How the resource can be accessed: Open (freely available), Restricted (limits on use), Closed (registration or approval required), or Embargoed (not yet available)",
            "alternateName": "Conditions Of Access",
            "disambiguatingDescription": "Open: freely available; Restricted: limits on use; Closed: registration or approval required; Embargoed: not yet available",
