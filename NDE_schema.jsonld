                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "keywords": {
            "description": "Keywords or tags used to describe this work.",
            "abstract": "Words or phrases that describe the resource",
            "alternateName": "Keywords",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "license": {
            "description": "A license document that applies to this work, typically indicated by URL.",
            "abstract": "Describes the legal terms for using the resource, usually as a link to the license information",
            "alternateName": "License",
            "format": "uri",
            "owl:cardinality": "one",
            "type": "string"
          },
          "sdPublisher": {
            "description": "Original publisher of the computational tool metadata (like GitHub, Dockstore, etc.).",
            "abstract": "The original publisher or catalog of the resource metadata",
            "alternateName": "Metadata Publisher",
            "oneOf": [
              {
                "$ref": "#/definitions/catalog"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/catalog"
                }
              }
            ],
            "owl:cardinality": "many"
          },
          "thumbnailUrl": {
            "description": "A thumbnail image of the computational tool.",
            "abstract": "Link to a small preview image",
            "alternateName": "Thumbnail Link",
            "owl:cardinality": "many",
            "type": "string",
            "format": "uri"
          },
          "description": {
            "description": "A description of the computational tool.",
            "abstract" : "An overview of the resource",
            "alternateName": "Description",
            "owl:cardinality": "one",
            "type": "string"
          },
          "identifier": {
            "description": "Identifier for the computational tool.",
            "abstract": "A unique ID for the resource",
            "alternateName": "Identifier",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "mainEntityOfPage": {
            "description": "Website or webpage which describes the work and provides additional details.",
            "abstract": "A webpage that primarily describes this resource and provides additional details",
            "alternateName": "Associated Webpage",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "name": {
            "description": "Computational tool name.",
            "abstract": "The full official name of the resource",
            "alternateName": "Name",
            "owl:cardinality": "one",
            "type": "string"
          },
          "sameAs": {
            "description": "URL of additional sources for the work.",
            "abstract": "Links to the resource in other places",
            "alternateName": "Also Listed As",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "url": {
            "description": "URL of the work.",
            "abstract": "The main website URL of the resource",
            "alternateName": "URL",
            "format": "uri",
            "owl:cardinality": "one",
            "type": "string"
          },
          "sourceOrganization": {
            "description": "The organization, research project, working group, or funded program on whose behalf the author/creator was working.",
            "abstract": "The research network, project, center, program, etc. that created the resource",
            "alternateName": "Program Collection",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/researchproject"
                }
              },
              {
                  "$ref": "#/definitions/researchproject"
