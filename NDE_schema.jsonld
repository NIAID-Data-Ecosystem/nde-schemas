                    "type": "string",
                    "format": "uri"
                  }    
                ]
              },
              "datePublished": {
                "description": "Date the referenced work was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "description": {
                "description": "Description of the referenced work",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "hasPart": {
                "description": "A portion of the work",
                "abstract": "Part(s) that make up the resource",
                "alternateName": "Component",
                "oneOf": [
                  {
                    "$ref": "#/definitions/citationobject"
                  }
                ]
              },
              "includedInDataCatalog": {
                "description": "Data or tool catalog which houses the work",
                "abstract": "The repository or catalog where the resource is listed",
                "alternateName": "Source",
                "oneOf": [
                  {
                    "$ref": "#/definitions/catalog"
                  }
                ]
              },
              "name": {
                "description": "Name or title",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the work",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "relationship": {
                "description": "How the works are related",
                "abstract": "How the resource is related to another resource",
                "alternateName": "Relationship",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced work",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "url": {
                "description": "The url of the work",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "citation": {
                "description": "The bibliographic citation for the referenced work as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "additionalType", "datePublished", "doi", "identifier", "includedInDataCatalog", "relationship", "url"],
            "optional": ["abstract", "citation", "description", "hasPart"]
          },
          "topic": {
            "description": "Topic assigned to the work.",
            "type": "string",
            "vocabulary": {
              "ontology": ["edam"],
              "children_of": ["http://edamontology.org/topic_0003"]
            },
            "strict": true
          },
          "catalog": {
            "@type": "DataCatalog",
            "description": "Data or tool catalog",
            "type": "object",
            "properties": {
              "name": {
                "description": "Data or tool catalog name",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier for the catalog within the Discovery Portal",
                "abstract": "The identifier of the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "Link to data or tool catalog",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "versionDate": {
                "description": "date the metadata was harvested from the catalog",
                "abstract": "Date the version was released",
                "alternateName": "Version Date",
                "type": "string",
                "format": "date"
              },
              "archivedAt": {
                "description": "The url(s) of one or more datasets, tools, resources or other items listed in a DataCatalog or ResourceCatalog",
                "abstract": "Link to the resource metadata record at the original source",
                "alternateName": "Source URL", 
                "oneOf": [
                  {
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "type": "array"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": ["name", "url"],
            "recommended": ["identifier", "versionDate", "archivedAt"]
          },
          "organization": {
            "@type": "Organization",
            "description": "Reusable organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier"],
            "optional": ["alternateName", "email", "parentOrganization", "role", "url"],
            "type": "object"
          },
          "researchproject": {
            "@type": "ResearchProject",
            "description": "a type of organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "Role the person played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier", "url", "parentOrganization"],
            "optional": ["alternateName", "email", "role"],
            "type": "object"
          },
          "person": {
            "@type": "Person",
            "description": "Reusable person definition",
            "properties": {
              "affiliation": {
                "abstract": "The person's institutional or organizational affiliation",
                "alternateName": "Affiliation",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name of the affiliation, such as a university",
                    "abstract": "The full official name of the affiliation",
                    "alternateName": "Name",
                    "type": "string"
                  },
                  "identifier": {
                    "description": "An identifier for the affiliation",
                    "abstract": "ID of the affiliation",
                    "alternateName": "Identifier",
                    "type": "string"
                  },
                  "url": {
                    "description": "URL of the affiliation",
                    "abstract": "The main website URL of the resource",
                    "alternateName": "URL",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["name"],
                "optional": ["identifier", "url"]
              },
              "name": {
                "description": "Name of the person",
                "abstract": "The full official name of the person",
                "alternateName": "Name",
                "type": "string"
              },
              "email": {
                "description": "Email address of the person",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "familyName": {
                "description": "Family name (surname) of the person",
                "abstract": "An individual's family name or surname",
                "alternateName": "Last Name",
                "type": "string"
              },
              "givenName": {
                "description": "Given (first) name of the person",
                "abstract": "An individual's given name",
                "alternateName": "First Name",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the person, like an ORCID ID",
                "abstract": "A unique ID for the person",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "Role the person played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the homepage or other web content describing the person",
                "abstract": "The main website URL of the person",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["familyName", "givenName", "identifier"],
            "optional": ["affiliation", "email", "role", "url"],
            "type": "object"
          },
          "definedterm": {
            "@type": "DefinedTerm",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "owl:cardinality": "one",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See background notes for more details.",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "owl:cardinality": "one",
                "type": "string"           
              },
              "url": {
                "description": "URL of the item.",
                "abstract": "The main website URL of the item",
                "alternateName": "URL",
                "owl:cardinality": "one",
                "type": "string",
                "format": "uri"
              },
              "curatedBy": {
                "description": "The person, organization, or catalog that curated this DefinedTerm for the metadata property",
                "abstract": "Human(s) or automated algorithm(s) that curated the resource or its metadata",
                "alternateName": "Curated By",
                "anyOf": [
                  {
                    "$ref": "#/definitions/person"
                  },
                  {
                    "$ref": "#/definitions/organization"
                  },
                  {
                    "$ref": "#/definitions/catalog"
                  },
                  {
                    "$ref": "#/definitions/researchproject"
                  },
                  {
                    "$ref": "#/definitions/softwareapplication"
                  }
                ]
              },
              "termCode": {
                "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
                "abstract": "The code for the term in its source ontology",
                "alternateName": "Term Code",
                "type": "string"
              },
              "description": {
                "description": "A description of the item.",
                "abstract" : "An overview of the item",
                "alternateName": "Description",
                "type": "string"
              },
              "inDefinedTermSet": {
                "description": "A DefinedTermSet that contains this term.",
                "abstract": "Ontology or controlled vocabulary from which the term comes",
                "alternateName": "Ontology",
                "type": "string"
              },
              "originalName": {
                "description": "The original name of the item, before any metadata standardization/normalization",
                "abstract": "The term as it appeared before standardization",
                "alternateName": "Original Name",
                "type": "string"
              },
              "isCurated": {
                "description": "A boolean indicator describing whether or not this DefinedTerm was curated as the value of a property.",
                "abstract": "Whether the information was reviewed by a curator",
                "alternateName": "Curated",
                "type": "boolean"
              }
            },
            "required": []  
          },
          "quantitativevalue": {
            "@type": "QuantitativeValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              }
            },
            "required" : ["unitText"],
            "recommended": ["value"],
            "optional": ["maxValue","minValue"]
          },
          "softwareapplication": {
            "@type": "SoftwareApplication",
            "description": "Reusable software or algorithm definition",
            "properties": {
              "name": {
                "description": "name of the software, computational tool, or algorithm.",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "dateModified": {
                "description": "date the software, computational tool, or algorithm was run",
                "abstract": "Date the tool was most recently run",
                "alternateName": "Date Modified",
                "type": "string",
                "format": "date"
              },
              "url": {
                "description": "url of the software, computational tool, or algorithm",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["url"],
            "optional": ["dateModified"],
            "type": "object"
          },
          "sample": {
            "@type": "Sample",
            "description": "reusable sample object",
            "abstract": "Samples used to generate the resource",
            "alternateName": "Sample",
            "type": "object",
            "properties": {
              "name": {
                "description": "sample name",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "url": {
                "description": "Link to sample",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "identifier": {
                "description": "an identifier for the sample",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "includedInDataCatalog": {
                "description": "Data or resource catalog where the sample is listed",
                "abstract": "The repository or catalog where the resource is listed",
                "alternateName": "Source",
                "oneOf": [
                  {
                    "$ref": "#/definitions/catalog"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/catalog"
                    }
                  }
                ]
              }
            },
            "required": ["url", "identifier"],
            "recommended": ["name", "includedInDataCatalog"]
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A property value pair",
            "type": "object",
            "properties": {
              "value": {
                "description": "A value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "string"
              },
              "name": {
                "description": "Name of the property",
                "abstract": "The full official name of the property",
                "alternateName": "Name",
                "type": "string"
              }
            },
            "required" : ["name"],
            "recommended": ["value"]
          },
          "coordinates": {
            "@type": "GeoCoordinates",
            "description": "The geographic coordinates of a place",
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              },
              "elevation": {
                "type": "string"
              }
            }
          },
          "adminarea": {
            "@type": "AdministrativeArea",
            "type": "object",
            "description": "Location information",
            "properties": {
              "administrativeType": {
                "description": "the type of administrative area, such as country, state, county, or city",
                "abstract": "The type of geographic area defined by how it is administered or governed",
                "alternateName": "Administrative Type",
                "disambiguatingDescription": "Province: a large administrative division of a country, often with its own regional government; District: a subdivision of a province, state, or region used for local administration; Chiefdom: a territory ruled by a traditional chief, common in parts of West Africa; Village: a small rural community, usually smaller than a town; City: a large, densely populated urban area with its own local government; Country: a sovereign nation with its own government and defined borders; Prefecture: an administrative division headed by a prefect, used in places like Japan, France, and Guinea; Sub-prefecture: a smaller administrative unit within a prefecture; Clan: a group of families who share a common ancestor or heritage; Federal Capital Territory: a special area, such as Abuja in Nigeria, that serves as the national capital and isn’t part of any state; State: a self-governing region within a federal country, such as Nigeria or the United States; Local Government Area: the third tier of government in Nigeria, similar to a county or municipality; Ward: the smallest electoral or administrative unit within a local government area or city; Region: a broad area defined by geography, culture, or administration, often larger than a district; Continent: one of Earth’s seven major landmasses, such as Africa or Asia; Military installation: a facility or base used by armed forces for operations, training, or housing; Other: any location type that doesn’t fit the categories listed above.",
                "enum": ["province", "district", "chiefdom", "village", "city", "country", "prefecture", "sub-prefecture", "clan", "Federal Capital Territory", "state", "Local Government Area", "ward", "region", "continent", "military installation", "other"],
                "type": "string"
              },
              "alternateName": {
                "description": "An alias for the location",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "identifier": {
                "description": "An identifier for the location, preferably a Wikidata ID",
                "abstract": "A unique ID for the Place",
                "alternateName": "Identifier",
                "type": "string"
              },
              "locationType": {
                "description": "Categorization of how the location relates to the dataset",
                "abstract": "How the location relates to the resource",
                "alternateName": "Location Type",
                "disambiguatingDescription": "Residence: the subjects reside in the geographic area; Exposure: the subjects were exposed to a disease-causing agent in the geographic area; Collection: the data or samples were collected in the geographic area; Treatment: the subjects or samples were treated in the geographic area; Study location: the study was conducted in the geographic area; Item location: the sample or item is located in the geographic area; Other: there is a different relationship between the geographic area and the resource; Unknown: the relationship between the geographic area and the resource is not known",
                "oneOf": [
                  {
                    "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "name": {
                "description": "The name of the location",
                "abstract": "The full official name of the Place",
                "alternateName": "Name",
                "type": "string"
              },
              "geo": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/coordinates"
                    }
                  },
                  {
                      "$ref": "#/definitions/coordinates"
                  }
                ]
                  }
            }
          }
        }
      }
    },
    {
      "@id": "nde:SampleCollection",
      "@type": "rdfs:Class",
      "rdfs:comment": "Sample collections contained in the NIAID Data Ecosystem. A SampleCollection is a collection of samples with some aggregate information about the collection itself. A SampleCollection can be useful for describing sample information when only aggregated sample-level metadata is provided due to privacy issues that prevent sharing of individual sample-level metadata record.",
      "abstract": "Samples collections contained in the NIAID Data Ecosystem. A sample collection is an aggregate sample record.",
      "rdfs:label": "SampleCollection",
      "rdfs:subClassOf": {
          "@id": "schema:ItemList"
      },
      "schema:schemaVersion":["https://schema.org/docs/releases.html#v18.0","v0.5 - 2026.11.18"],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Add 'disambiguatingDescription' to properties with enum values to provide structured definitions of enum values. Drop 'title' from reusable Person objects, drop 'affiliation' from reusable Organization objects, add 'geo' to 'AdministrativeArea' objects, add 'identifier' to DataCatalog objects for 'includedInDataCatalog'. Replaced 'itemReviewed' with 'reviewAspect' in AggregateRating objects. Updated 'locationType' enum values for 'AdministrativeArea' object to allow for coverage of 'itemLocation' and 'locationOfOrigin' so that 'spatialCoverage' could be used instead and dropped 'itemLocation' and 'locationOfOrigin'.",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "description": "Sample name.",
            "abstract": "The full official name of the resource",
            "alternateName": "Name",
            "owl:cardinality": "one",
            "type": "string"
          },
          "description": {
            "description": "A description of the sample.",
            "abstract" : "An overview of the resource",
            "alternateName": "Description",
            "owl:cardinality": "one",
            "type": "string"
          },
          "identifier": {
            "description": "Sample identifier or accession number, such as a digital object identifier (DOI), sequence read archive (SRA) or GenBank accession number, etc.",
            "abstract": "A unique ID for the resource",
            "alternateName": "Identifier",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "owl:cardinality": "many"
          },
          "sameAs": {
            "description": "URL of additional sources for the work.",
            "abstract": "Links to the resource in other places",
            "alternateName": "Also Listed As",
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ],
            "owl:cardinality": "many"
          },
          "url": {
            "description": "URL of the work.",
            "abstract": "The main website URL of the resource",
            "alternateName": "URL",
            "type": "string",
            "format": "uri",
            "owl:cardinality": "one"
          },
          "includedInDataCatalog": {
            "description": "Data or resource catalog where the sample is listed; original source of the metadata.",
            "abstract": "The repository or catalog where the resource is listed",
            "alternateName": "Source",
            "oneOf": [
              {
                "$ref": "#/definitions/catalog"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/catalog"
                }
              }
            ],
            "owl:cardinality": "one"
          },
          "numberOfItems": {
            "description": "The number of sample records in the sample collection. Min/max estimates can be used in lieu of actual number. If completely unknown, set value = 0, and unitText = 'unknown'",
            "abstract": "Total number of samples in the resource",
            "alternateName": "Number of Samples",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/quantitativevalue"
                }
              },
              {
                "$ref": "#/definitions/quantitativevalue"
              }    
            ],
            "owl:cardinality": "many"             
          },
          "itemListElement": {
            "description": "The list of samples that are included in the sample collection",
            "abstract": "Individual samples included in the resource",
            "alternateName": "Included Samples",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/minsample"
                }
              },
              {
                  "$ref": "#/definitions/minsample"
              },
              {
                  "type": "string",
                  "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ],
            "owl:cardinality": "many"
          },
          "aggregateElement": {
            "description": "Aggregate values derived from the samples in the collection.",
            "abstract": "Information aggregated across all the samples that were combined to form the resource",
            "alternateName": "Aggregated Information",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/sample"
                }
              },
              {
                  "$ref": "#/definitions/sample"
              }
            ],
            "owl:cardinality": "many"
          }
        },
        "required": ["aggregateElement", "numberOfItems"],
        "recommended": ["itemListElement", "url", "identifier", "sameAs", "includedInDataCatalog"],
        "optional": ["name", "description"],
        "definitions": {
          "citationobject": {
            "description": "A citation object for a resource which is cited by the dataset (ie- is a derivative of the dataset) , related to the dataset, or from which the dataset was based on (ie- is derived from).",
            "@type": "ScholarlyArticle",
            "type": "object",
            "properties": {
              "author": {
                "description": "Author(s) of the publication",
                "abstract": "Individual(s) or organization(s) who created the reference",
                "alternateName": "Author",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/person"
                    }
                  },
                  {
                      "$ref": "#/definitions/person"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/organization"
                    }
                  },
                  {
                      "$ref": "#/definitions/organization"
                  }
                ]
              },
              "abstract": {
                "description": "Abstract of the publication",
                "abstract": "A short summary of the reference",
                "alternateName": "Abstract",
                "type": "string"
              },
              "datePublished": {
                "description": "Date the article was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "description": {
                "description": "Description of the publication",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
