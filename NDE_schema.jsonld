          "species": {
            "description": "Species / host organism from which the dataset has been collected.",
            "abstract": "Species / host organism from which the resource has been collected or generated",
            "alternateName": "Host Species",
            "anyOf": [
              {
                "description": "collection of vocabulary terms defined in ontologies",
                "strict": false,
                "type": "string",
                "vocabulary": {
