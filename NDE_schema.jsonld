          "additionalType": {
            "description": "The subclassification of the Sample based on where it was intended to be indexed. Use 'ExperimentalRunSample' for samples intended for sequencing and other experimental run repositories vs 'BioSample' for samples intended for biospecimen, biobank, or other biological reagent repositories. If a sample is expected to be indexed in both types, use an array and list both types.",
            "abstract": "More classifications for the sample",
            "alternativeName": "Also Classified As",
            "disambiguatingDescription": "ExperimentalRunSample: samples intended for sequencing and other experimental run repositories; BioSample: samples intended for biospecimen, biobank, or other biological reagent repositories",
            "anyOf": [
