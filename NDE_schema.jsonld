            "alternateName": "Usage Statistic",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "items": {
                  "@type": "InteractionCounter",
                  "type": "object",
                  "properties": {
                    "interactionType": {
                      "description": "The Action representing the type of interaction. For up votes, +1s, etc. use LikeAction. For down votes use DislikeAction. Otherwise, use the most specific Action.",
                      "abstract": "The kind of user interaction being counted",
                      "alternateName": "Interaction Type",                        
                      "type": "string"
                    },
                    "userInteractionCount": {
                      "description": "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication.",
                      "abstract": "The number of times users interacted with the resource",
                      "alternateName": "Number of User Interactions",
                      "type": "integer"
                    }
                  },
                  "required": ["interactionType", "userInteractionCount"]
                },
                "type": "array"
              },
              {
                "@type": "InteractionCounter",
                "type": "object",
                "properties": {
                  "interactionType": {
                    "description": "The Action representing the type of interaction. For up votes, +1s, etc. use LikeAction. For down votes use DislikeAction. Otherwise, use the most specific Action.",
                    "abstract": "The kind of user interaction being counted",
                    "alternateName": "Interaction Type",                      
                    "type": "string"
                  },
                  "userInteractionCount": {
                    "description": "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication.",
                    "abstract": "The number of times users interacted with the resource",
                    "alternateName": "Number of User Interactions",
                    "type": "integer"
                  }
                },
                "required": ["interactionType", "userInteractionCount"]
              }
            ]
          },
          "isAccessibleForFree": {
            "description": "A flag to signal that the work is accessible for free. This does NOT mean that there are no costs associated with making the resource available and users should take care not to abuse freely accessible sources.",
            "abstract": "Whether the resource can be accessed at no cost",
            "alternateName": "Free Access",
            "owl:cardinality": "one",
            "type": "boolean"
          },
          "isBasedOn": {
            "description": "A dataset, publication, or computational tool from which this work is derived, modified, or adapted.",
            "abstract": "Earlier works, other resources, or protocols from which the resource was derived",
            "alternateName": "Based On",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
