                "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "version": {
            "description": "Resource catalog version.",
            "abstract": "Version number of the resource",
            "alternateName": "Version",
            "type": "string",
            "owl:cardinality": "one"
          },
          "alternateName": {
            "description": "An alias for the resource catalog name.",
            "abstract": "Other names for the resource",
            "alternateName": "Alternate Name",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "owl:cardinality": "many"
          },
          "description": {
            "description": "A description of the resource catalog.",
            "abstract" : "An overview of the resource",
            "alternateName": "Description",
            "owl:cardinality": "one",
            "type": "string"
          },
          "identifier": {
            "description": "Resource catalog identifier or accession number, such as a digital object identifier (DOI),  etc.",
            "abstract": "A unique ID for the resource",
            "alternateName": "Identifier",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "owl:cardinality": "many"
          },
          "mainEntityOfPage": {
            "description": "Website or webpage which describes the work and provides additional details.",
            "abstract": "A webpage that primarily describes this resource and provides additional details",
            "alternateName": "Associated Webpage",
            "oneOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "type": "array"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ],
            "owl:cardinality": "many"
          },
          "name": {
            "description": "Resource catalog name.",
            "abstract": "The full official name of the resource",
            "alternateName": "Name",
