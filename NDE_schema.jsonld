            "abstract": "The NCT number that identifies the related clinical trial",
            "alternateName": "ClinicalTrials.gov ID",
            "type": "string",
            "owl:cardinality": "many"
          },
          "relationship": {
            "description": "How an associated work is related to the dataset.",
            "abstract": "How the resource is related to another resource",
            "alternateName": "Relationship",
            "type": "string",
            "owl:cardinality": "one"
          },
          "topicCategory": {
            "description": "The Research Topic, Domain, or Discipline of the work. This topic may be assigned by a human curator or through automated algorithms.",
            "abstract": "Research topics covered by the resource. This topic may be assigned by a human curator or through automated algorithms",
            "alternateName": "Topic Category",
            "anyOf": [
              {
                "type": "array",
