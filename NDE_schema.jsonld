          },
          "funding": {
            "description": "Funding that supports (sponsors) the collection of this dataset through some kind of financial contribution.",
            "abstract": "Grants or other financial support used to create or maintain the resource",
            "alternateName": "Funding",
            "oneOf": [
              {
                "type": "object",
                "@type": "MonetaryGrant",
                "description": "Funding that supports (sponsors) the collection of this dataset through some kind of financial contribution",
                "properties": {
