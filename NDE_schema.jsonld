          "minsampleinfo": {
            "@type": "Sample",
            "description": "reusable sample object",
            "type": "object",
            "properties": {
              "url": {
                "description": "Link to sample",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "identifier": {
                "description": "an identifier for the sample",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "includedInDataCatalog": {
                "description": "Data or resource catalog where the sample is listed",
                "abstract": "The repository or catalog where the resource is listed",
                "alternateName": "Source",
                "oneOf": [
                  {
                    "$ref": "#/definitions/catalog"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/catalog"
                    }
                  }
                ]
              }                                                
            },
            "recommended": ["url", "identifier", "includedInDataCatalog"]
          },
          "quantitativevalue": {
            "@type": "QuantitativeValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              }
            },
            "required" : ["unitText"],
            "recommended": ["value"],
            "optional": ["maxValue","minValue"]
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be (1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3) a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry). Standards bodies should promote a standard prefix for the identifiers of properties from their standards.",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required" : ["unitText"],
            "recommended": ["value","propertyID"],
            "optional": ["maxValue","minValue"]
          },
          "propvalpair": {
            "@type": "PropertyValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "name": {
                "description": "The name of the property.",
                "abstract": "The full official name of the property",
                "alternateName": "Name",
                "type": "string"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be (1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3) a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry). Standards bodies should promote a standard prefix for the identifiers of properties from their standards.",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required" : ["name"],
            "recommended": ["value","propertyID"],
            "optional": ["unitText"]
          },
          "coordinates": {
            "@type": "GeoCoordinates",
            "description": "The geographic coordinates of a place",
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              },
              "elevation": {
                "type": "string"
              }
            }
          },
          "adminarea": {
            "@type": "AdministrativeArea",
            "type": "object",
            "description": "Location information",
            "properties": {
              "administrativeType": {
                "description": "the type of administrative area, such as country, state, county, or city",
                "abstract": "The type of geographic area defined by how it is administered or governed",
                "alternateName": "Administrative Type",
                "disambiguatingDescription": "Province: a large administrative division of a country, often with its own regional government; District: a subdivision of a province, state, or region used for local administration; Chiefdom: a territory ruled by a traditional chief, common in parts of West Africa; Village: a small rural community, usually smaller than a town; City: a large, densely populated urban area with its own local government; Country: a sovereign nation with its own government and defined borders; Prefecture: an administrative division headed by a prefect, used in places like Japan, France, and Guinea; Sub-prefecture: a smaller administrative unit within a prefecture; Clan: a group of families who share a common ancestor or heritage; Federal Capital Territory: a special area, such as Abuja in Nigeria, that serves as the national capital and isn’t part of any state; State: a self-governing region within a federal country, such as Nigeria or the United States; Local Government Area: the third tier of government in Nigeria, similar to a county or municipality; Ward: the smallest electoral or administrative unit within a local government area or city; Region: a broad area defined by geography, culture, or administration, often larger than a district; Continent: one of Earth’s seven major landmasses, such as Africa or Asia; Military installation: a facility or base used by armed forces for operations, training, or housing; Other: any location type that doesn’t fit the categories listed above.",
                "enum": ["province", "district", "chiefdom", "village", "city", "country", "prefecture", "sub-prefecture", "clan", "Federal Capital Territory", "state", "Local Government Area", "ward", "region", "continent", "military installation", "other"],
                "type": "string"
              },
              "alternateName": {
                "description": "An alias for the location",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "identifier": {
                "description": "An identifier for the location, preferably a Wikidata ID",
                "abstract": "A unique ID for the Place",
                "alternateName": "Identifier",
                "type": "string"
              },
              "locationType": {
                "description": "Categorization of how the location relates to the dataset",
                "abstract": "How the location relates to the resource",
                "alternateName": "Location Type",
                "disambiguatingDescription": "Residence: the subjects reside in the geographic area; Exposure: the subjects were exposed to a disease-causing agent in the geographic area; Collection: the data or samples were collected in the geographic area; Treatment: the subjects or samples were treated in the geographic area; Study location: the study was conducted in the geographic area; Item location: the sample or item is located in the geographic area; Other: there is a different relationship between the geographic area and the resource; Unknown: the relationship between the geographic area and the resource is not known",
                "oneOf": [
                  {
                    "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "name": {
                "description": "The name of the location",
                "abstract": "The full official name of the Place",
                "alternateName": "Name",
                "type": "string"
              },
              "geo": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/coordinates"
                    }
                  },
                  {
                      "$ref": "#/definitions/coordinates"
                  }
                ]
                  }
            }
          }
        }
      }
    },
    {
      "@id": "nde:SemanticTriple",
      "@type": "rdfs:Class",
      "rdfs:comment": "The SemanticTriple is a structured representation of a subject–predicate–object assertion, modeled after the RDF triple pattern used in knowledge graphs and linked data systems. While schema.org/Statement provides a general mechanism for reifying claims about entities, SemanticTriple makes the triple structure explicit and unambiguous, enabling direct, lossless translation between schema.org markup and RDF-based knowledge graph formats such as RDF/XML, Turtle, JSON-LD, and N-Triples.",
      "rdfs:label": "SemanticTriple",
      "schemaVersion": [
        "https://schema.org/docs/releases.html#v30.0", "v0.2 - 2026.11.18"
      ],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI.",
      "rdfs:subClassOf": {
        "@id": "schema:Statement"
      },
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "isSymmetric": {
            "description": "A boolean indicating whether the triple's predicate asserts a symmetric relationship — that is, if A relates to B, then B relates to A by the same predicate. For example, biolink:correlated_with is symmetric, while biolink:regulates is not. Corresponds to owl:SymmetricProperty in OWL and symmetric: true in the Biolink Model.",
            "abstract": "Whether the relationship holds the same in both directions",
            "alternateName": "Symmetric",
            "owl:cardinality": "one",
            "type": "boolean"
          },
          "inversePredicate": {
            "description": "The predicate that expresses the inverse of this triple's relationship. The predicate which would be used if subject and object were swapped. Only meaningful when isSymmetric is false. For example, the inverse of biolink:regulates is biolink:regulated_by. Corresponds to owl:inverseOf in OWL and the inverse: slot on predicate definitions in the Biolink Model.",
            "abstract": "Relationship between two entities in the reverse direction",
            "alternateName": "Inverse Predicate",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string"
              }
            ]
          },
          "tripleObject": {
            "description": "The value or entity the predicate points to (corresponding to the RDF object). ",
            "abstract": "The entity a relationship points to; the object in the subject-predicate-object assertion",
            "alternateName": "Object",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string"
              }
            ]
          },
          "triplePredicate": {
            "description": "The relationship being asserted, observed, inferred, between the subject and the object (corresponding to the RDF predicate)",
            "abstract": "The relationship that connects the subject and object; the predicate in the subject-predicate-object assertion",
            "alternateName": "Predicate",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string"
              }
            ]
          },
          "tripleSubject": {
            "description": "The entity the assertion, observation, or inference is about (corresponding to the RDF subject). ",
            "abstract": "The entity a statement is about; the subject in the subject-predicate-object assertion",
            "alternateName": "Subject",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string"
              }
            ]
          },
          "tripleObjectQualifier": {
            "description": "Contextual or qualifying information about the object of the assertion, observation, or inference. For example, a chemical entity object may be qualified by its form (e.g. abundance or activity of a gene product), or a phenotypic feature object may be qualified by its severity, onset, or frequency in the context of a given disease association. Corresponds to object-level qualifiers in RDF-star annotations or RDF literal metadata.",
            "abstract": "Contextual information about the object of the assertion/inference",
            "alternateName": "Object Qualifier",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "tripleSubjectQualifier": {
            "description": "Contextual or qualifying information about the subject of the assertion, observation, or inference. For example, a disease subject may be qualified by the anatomical location or cell type in which it manifests. Corresponds to subject-level qualifiers in RDF-star annotations or named graph metadata.",
            "abstract": "Contextual information about the subject of the assertion/inference",
            "alternateName": "Subject Qualifier",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "triplePredicateQualifier": {
            "description": "Contextual or qualifying information about the predicate of the assertion, observation, or inference. For example, a 'gene associated with disease' predicate may be qualified by the association type (e.g. causal vs. correlated), the direction of effect (e.g. gain-of-function vs. loss-of-function), or the knowledge source (e.g. curated vs. inferred). Corresponds to predicate-level qualifiers in RDF-star annotations or property path metadata.",
            "abstract": "Contextual information about the predicate of the assertion/inference",
            "alternateName": "Predicate Qualifier",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "name": {
            "description": "The name of the item.",
            "abstract": "The full official name of the item",
            "alternateName": "Name",
            "owl:cardinality": "one",
            "type": "string"
          }
        },
        "required": [
          "tripleObject",
          "triplePredicate",
          "tripleSubject"
        ],
        "recommended": [
          "isSymmetric",
          "inversePredicate",
          "tripleObjectQualifier",
          "tripleSubjectQualifier",
          "triplePredicateQualifier"
        ],
        "optional": [
          "name"
        ],
        "definitions": {
          "definedterm": {
            "@type": "DefinedTerm",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "owl:cardinality": "one",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See background notes for more details.",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "owl:cardinality": "one",
                "type": "string"
              },
              "url": {
                "description": "URL of the item.",
                "abstract": "The main website URL of the item",
                "alternateName": "URL",
                "owl:cardinality": "one",
                "type": "string",
                "format": "uri"
              },
              "termCode": {
                "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
                "abstract": "The code for the term in its source ontology",
                "alternateName": "Term Code",
                "type": "string"
              },
              "description": {
                "description": "A description of the item.",
                "abstract" : "An overview of the item",
                "alternateName": "Description",
                "type": "string"
              },
              "inDefinedTermSet": {
                "description": "A DefinedTermSet that contains this term.",
                "abstract": "Ontology or controlled vocabulary from which the term comes",
                "alternateName": "Ontology",
                "type": "string"
              },
              "originalName": {
                "description": "The original name of the item, before any metadata standardization/normalization",
                "abstract": "The term as it appeared before standardization",
                "alternateName": "Original Name",
                "type": "string"
              },
              "isCurated": {
                "description": "A boolean indicator describing whether or not this DefinedTerm was curated as the value of a property.",
                "abstract": "Whether the information was reviewed by a curator",
                "alternateName": "Curated",
                "type": "boolean"
              }
            },
            "required": []              
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A property-value pair, e.g. representing a feature of a product or place. Use the 'name' property for the name of the property. If there is an additional human-readable version of the value, put that into the 'description' property.",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the property.",
                "abstract": "The full official name of the property",
                "alternateName": "Name",
                "type": "string"
              },
              "value": {
                "description": "The value of a QuantitativeValue (including Observation) or property value node.",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property...",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": [
                "name",
                "value"
            ],
            "recommended": [
                "propertyID"
            ],
            "optional": [
                "unitText"
            ]
             
          }
        }
      }
    },
    {
      "@id": "nde:Inference",
      "@type": "rdfs:Class",
      "rdfs:comment": "The Inference Type describes a discrete observation, assertion, result/conclusion drawn from and/or about a dataset or a collection of data. Note that while the Inference type itself is used to model or capture a primary observation, assertion, result/conclusion akin to a semantic triple; it's schema.org-based structure may also include provenance-related information (akin to provenance-related semantic triples). Lastly, the schema include key Discovery Portal properties to enable improved search.",
      "rdfs:label": "Inference",
      "rdfs:subClassOf": {
        "@id": "schema:Observation"
      },
      "schemaVersion": [
        "https://schema.org/docs/releases.html#v30.0", "v0.2 - 2026.11.18" 
      ],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Add 'identifier' to DataCatalog objects for 'includedInDataCatalog'.",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "observationType": {
            "description": "One or more categories of the inference. The categories may reflect specific triple patterns or motifs. For example, gene x is upregulated in disease y OR gene x is differentiall expressed in disease y.",
            "abstract": "The kind of observation made",
            "alternateName": "Observation Type",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]            
          },
          "semanticMapping": {
            "description": "An explicit mapping of the inference to a SemanticTriple format. Schema.org classes are structured such that each property is a predicate, each Class is the 'subject' and the value of each property is the object. This can be confusing when the class (like the Inference type) can potentially be similar to a semantic triple on its own. While potentially redundant, this property enables explicit and unambiguous mapping of the inference to a semantic triple for increased interpretability.",
            "abstract": "An explicit mapping of the inference to a SemanticTriple format",
            "alternateName": "Semantic Triple Mapping",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "$ref": "#/definitions/semantictriple"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/semantictriple"
                }
              }
            ]
          },
          "analyticalMethod": {
            "description": "One or more analytical methods or techniques used to create the inference from the data",
            "abstract": "Statistical or computational method(s) used to produce the inference",
            "alternateName": "Analytical Method",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]
          },
          "infectiousAgent": {
            "description": "An infectious agent associated with the inference",
            "abstract": "Infectious agent(s) or pathogen(s) which are the focus of the resource",
            "alternateName": "Pathogen species",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/pathogen"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/pathogen"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ]
          },
          "species": {
            "description": "A host organism associated with the inference.",
            "abstract": "Species / host organism from which the resource has been collected or generated",
            "alternateName": "Host Species",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/organism"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/organism"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ]
          },
          "healthCondition": {
            "description": "A health condition associated with the inference",
            "abstract": "Health condition(s) or infectious disease(s) which are the focus of the resource",
            "alternateName": "Health Condition",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/disease"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/disease"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ]
          },
          "includedInDataCatalog": {
            "description": "The source of the inference itself",
            "abstract": "The repository or catalog where the resource is listed",
            "alternateName": "Source",
            "owl:cardinality": "many",
            "oneOf": [
              {
                "$ref": "#/definitions/catalog"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/catalog"
                }
              }
            ]
          },
          "sample": {
            "description": "Sample information associated with the inference",
            "abstract": "Samples used to generate the resource",
            "alternateName": "Sample",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/samplerecord"
                }
              },
              {
                  "$ref": "#/definitions/samplerecord"
              },
              {
                  "type": "string",
                  "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/samplecollection"
                }
              },
              {
                  "$ref": "#/definitions/samplecollection"
              }
            ]
          },
          "observationPeriod": {
            "description": "The length of time an Observation took place over. The format follows `P[0-9]*[Y|M|D|h|m|s]`. For example, P1Y is Period 1 Year, P3M is Period 3 Months, P3h is Period 3 hours.",
            "abstract": "Length of time over which the observation was made",
            "alternateName": "Observation Period",
            "owl:cardinality": "one",
            "oneOf": [
                {
                  "type": "string"
                },
                {
                  "@type": "TemporalInterval",
                  "description": "Temporal information",
                  "properties": {
                    "duration": {
                      "description": "A time interval in ISO 8601 duration format",
                      "abstract": "Time period covered by the resource using the ISO 8601 duration format",
                      "alternateName": "Duration",
                      "type": "string"
                    },
                    "endDate": {
                      "description": "An end date",
                      "abstract": "Date the time period covered by the resource ends",
                      "alternateName": "End Date",
                      "format": "date",
                      "type": "string"
                    },
                    "name": {
                      "description": "String describing the temporal interval",
                      "abstract": "The name of the temporal interval",
                      "alternateName": "Name",
                      "type": "string"
                    },
                    "startDate": {
                      "description": "A start date",
                      "abstract": "Date the time period covered by the resource begins",
                      "alternateName": "Start Date",
                      "format": "date",
                      "type": "string"
                    },
                    "temporalType": {
                      "description": "Categorization of how the date/temporal interval relates to the dataset",
                      "abstract": "The kind of temporal information",
                      "alternateName": "Time Period Type",
                      "disambiguatingDescription": "Exposure: time period in which the subject was exposed to a disease-causing agent; Collection: time period in which the data or samples were collected; screening: time period in which subjects were screened; Treatment: time period in which subjects were treated; Study date: timer period in which the study was active; Other: time period in which some known other activity took place; Unknown: time period provided without context",
                      "oneOf": [
                        {
                          "enum": ["exposure", "collection", "screening", "treatment", "study date", "other", "unknown"],
                          "type": "string"
                        },
                        {
                          "items": {
                            "enum": ["exposure", "collection", "screening", "treatment", "study date", "other", "unknown"],
                            "type": "string"
                          },
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "type": "object"
                }
            ]
          },
          "measurementQualifier": {
            "description": "Provides additional qualification to an observation. For example, a GDP observation measures the Nominal value.",
            "abstract": "Additional detail that describes how to interpret the measurement",
            "alternateName": "Measurement Qualifier",
            "owl:cardinality": "one",
            "type": "string"
          },
          "measuredProperty": {
            "description": "The measuredProperty of an [[Observation]], typically via its [[StatisticalVariable]]. There are various kinds of applicable [[Property]]: a schema.org property, a property from other RDF-compatible systems, e.g. W3C RDF Data Cube, Data Commons, Wikidata, or schema.org extensions such as [GS1's](https://www.gs1.org/voc/?show=properties).",
            "abstract": "The characteristic that was measured",
            "alternateName": "Measured Property",
            "owl:cardinality": "one",
            "anyOf": [
              {
                "$ref": "#/definitions/propobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propobject"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              }
            ]
          },
          "measurementTechnique": {
            "description": "A technique, method or technology used in an [[Observation]], [[StatisticalVariable]] or [[Dataset]] (or [[DataDownload]], [[DataCatalog]]), corresponding to the method used for measuring the corresponding variable(s) (for datasets, described using [[variableMeasured]]; for [[Observation]], a [[StatisticalVariable]]). Often but not necessarily each [[variableMeasured]] will have an explicit representation as (or mapping to) an property such as those defined in Schema.org, or other RDF vocabularies and \"knowledge graphs\". In that case the subproperty of [[variableMeasured]] called [[measuredProperty]] is applicable.\n    \nThe [[measurementTechnique]] property helps when extra clarification is needed about how a [[measuredProperty]] was measured. This is oriented towards scientific and scholarly dataset publication but may have broader applicability; it is not intended as a full representation of measurement, but can often serve as a high level summary for dataset discovery. \n\nFor example, if [[variableMeasured]] is: molecule concentration, [[measurementTechnique]] could be: \"mass spectrometry\" or \"nmr spectroscopy\" or \"colorimetry\" or \"immunofluorescence\". If the [[variableMeasured]] is \"depression rating\", the [[measurementTechnique]] could be \"Zung Scale\" or \"HAM-D\" or \"Beck Depression Inventory\". \n\nIf there are several [[variableMeasured]] properties recorded for some given data object, use a [[PropertyValue]] for each [[variableMeasured]] and attach the corresponding [[measurementTechnique]]. The value can also be from an enumeration, organized as a [[MeasurementMethodEnum]].",
            "abstract": "Methods or technologies used to generate the resource",
            "alternateName": "Measurement Technique",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]
          },
          "measurementDenominator": {
            "description": "Identifies the denominator variable when an observation represents a ratio or percentage.",
            "abstract": "Reference value used to calculate a ratio or rate",
            "alternateName": "Measurement Denominator",
            "owl:cardinality": "one",
            "$ref": "#/definitions/statvar"
          },
          "measurementMethod": {
            "description": "A subproperty of [[measurementTechnique]] that can be used for specifying specific methods, in particular via [[MeasurementMethodEnum]].",
            "abstract": "Method used to calculate or derive the value",
            "alternateName": "Measurement Method",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]
          },
          "observationDate": {
            "description": "The observationDate of an [[Observation]].",
            "abstract": "Date the observation or inference was made",
            "alternateName": "Date Observed",
            "owl:cardinality": "one",
            "format": "date",
            "type": "string"
          },
          "variableMeasured": {
            "description": "The variableMeasured property can indicate (repeated as necessary) the  variables that are measured in some dataset, either described as text or as pairs of identifier and description using PropertyValue, or more explicitly as a [[StatisticalVariable]].",
            "abstract": "Variables measured within the resource",
            "alternateName": "Variable Measured",
            "owl:cardinality": "one",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "$ref": "#/definitions/statvar"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/statvar"
                }
              }
            ]
          },
          "observationAbout": {
            "description": "The [[observationAbout]] property identifies an entity, often a [[Place]], associated with an [[Observation]].",
            "abstract": "Entity described by the observation",
            "alternateName": "Observation Subject",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "$ref": "#/definitions/thing"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/thing"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              }
            ]
          },
          "marginOfError": {
            "description": "A [[marginOfError]] for an [[Observation]].",
            "abstract": "Range of uncertainty around the value",
            "alternateName": "Margin of Error",
            "owl:cardinality": "one",
            "$ref": "#/definitions/definedterm"
          },
          "maxValue": {
            "description": "The upper value of some characteristic or property.",
            "abstract": "Highest value in a range",
            "alternateName": "Maximum Value",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "minValue": {
            "description": "The lower value of some characteristic or property.",
            "abstract": "Lowest value in a range",
            "alternateName": "Minimum Value",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "unitCode": {
            "description": "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon.",
            "abstract": "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL",
            "alternateName": "Unit Code",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "unitText": {
            "description": "A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for\n<a href='unitCode'>unitCode</a>.",
            "abstract": "The thing that is being counted or measured",
            "alternateName": "Unit",
            "type": "string",
            "owl:cardinality": "one"
          },
          "value": {
            "description": "The value of a [[QuantitativeValue]] (including [[Observation]]) or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.",
            "abstract": "A number or numeric measurement recorded for a property",
            "alternateName": "Value",
            "owl:cardinality": "one",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "valueReference": {
            "description": "A secondary value that provides additional information on the original value, e.g. a reference temperature or a type of measurement.",
            "abstract": "A reference that provides context for the value",
            "alternateName": "Value Reference",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]
          },
          "identifier": {
            "description": "The identifier property represents any kind of identifier for any kind of [[Thing]], such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See [background notes](/docs/datamodel.html#identifierBg) for more details.",
            "abstract": "A unique ID for the resource",
            "alternateName": "Identifier",
            "owl:cardinality": "one",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/propertyvalue"
              },
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/propertyvalue"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            ]
          },
          "name": {
            "description": "The name of the item.",
            "abstract": "The full official name of the item",
            "alternateName": "Name",
            "type": "string",
            "owl:cardinality": "one"
          },
          "subjectOf": {
            "description": "A CreativeWork or Event about this Thing.",
            "abstract": "Works that describe the resource",
            "alternateName": "Described In",  
            "owl:cardinality": "many",
            "oneOf": [
              {
                "$ref": "#/definitions/creativework"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              }
            ]
          },
          "url": {
            "description": "URL of the item.",
            "abstract": "The main website URL of the item",
            "alternateName": "URL",
            "type": "string",
            "format": "uri",
            "owl:cardinality": "one"
          },
          "date": {
            "description": "The date of the inference either taken from the observationDate, observationPeriod, or the date the inference was ingested.",
            "abstract": "The most recent of the observationDate or observationPeriod",
            "alternateName": "Date",
            "type": "string",
            "format": "date",
            "owl:cardinality": "one"
          }
        },
        "required": [
          "observationType",
          "includedInDataCatalog",
          "measurementQualifier",
          "measuredProperty",
          "observationAbout",
          "value",
          "url",
          "date"
        ],
        "recommended": [
          "semanticMapping",
          "analyticalMethod",
          "infectiousAgent",
          "species",
          "healthCondition",
          "measurementTechnique",
          "measurementDenominator",
          "observationDate",
          "variableMeasured",
          "unitCode",
          "unitText",
          "identifier",
          "name",
          "subjectOf"
        ],
        "optional": [
          "observationPeriod",
          "measurementMethod",
          "marginOfError",
          "maxValue",
          "minValue"
        ],
        "definitions": {
          "definedterm": {
            "@type": "DefinedTerm",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "owl:cardinality": "one",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See background notes for more details.",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "owl:cardinality": "one",
                "type": "string"
              },
              "url": {
                "description": "URL of the item.",
                "abstract": "The main website URL of the item",
                "alternateName": "URL",
                "owl:cardinality": "one",
                "type": "string",
                "format": "uri"
              },
              "termCode": {
                "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
                "abstract": "The code for the term in its source ontology",
                "alternateName": "Term Code",
                "type": "string"
              },
              "description": {
                "description": "A description of the item.",
                "abstract" : "An overview of the item",
                "alternateName": "Description",
                "type": "string"
              },
              "inDefinedTermSet": {
                "description": "A DefinedTermSet that contains this term.",
                "abstract": "Ontology or controlled vocabulary from which the term comes",
                "alternateName": "Ontology",
                "type": "string"
              },
              "originalName": {
                "description": "The original name of the item, before any metadata standardization/normalization",
                "abstract": "The term as it appeared before standardization",
                "alternateName": "Original Name",
                "type": "string"
              },
              "isCurated": {
                "description": "A boolean indicator describing whether or not this DefinedTerm was curated as the value of a property.",
                "abstract": "Whether the information was reviewed by a curator",
                "alternateName": "Curated",
                "type": "boolean"
              }
            },
            "required": []              
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A property-value pair, e.g. representing a feature of a product or place. Use the 'name' property for the name of the property. If there is an additional human-readable version of the value, put that into the 'description' property.",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the property.",
                "abstract": "The full official name of the property",
                "alternateName": "Name",
                "type": "string"
              },
              "value": {
                "description": "The value of a QuantitativeValue (including Observation) or property value node.",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property...",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": [
                "name",
                "value"
            ],
            "recommended": [
                "propertyID"
            ],
            "optional": [
                "unitText"
            ]
             
          },
          "semantictriple": {
            "@type": "SemanticTriple",
            "description": "The inference explicitly mapped as a semantic triple",
            "type": "object",
            "properties": {
              "isSymmetric": {
                "description": "A boolean indicating whether the triple's predicate asserts a symmetric relationship — that is, if A relates to B, then B relates to A by the same predicate. For example, biolink:correlated_with is symmetric, while biolink:regulates is not. Corresponds to owl:SymmetricProperty in OWL and symmetric: true in the Biolink Model.",
                "owl:cardinality": "one",
                "type": "boolean"
              },
              "inversePredicate": {
                "description": "The predicate that expresses the inverse of this triple's relationship. The predicate which would be used if subject and object were swapped. Only meaningful when isSymmetric is false. For example, the inverse of biolink:regulates is biolink:regulated_by. Corresponds to owl:inverseOf in OWL and the inverse: slot on predicate definitions in the Biolink Model.",
                "owl:cardinality": "one",
                "oneOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "tripleObject": {
                "description": "The value or entity the predicate points to (corresponding to the RDF object). ",
                "owl:cardinality": "one",
                "oneOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "triplePredicate": {
                "description": "The relationship being asserted, observed, inferred, between the subject and the object (corresponding to the RDF predicate)",
                "owl:cardinality": "one",
                "oneOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "tripleSubject": {
                "description": "The entity the assertion, observation, or inference is about (corresponding to the RDF subject). ",
                "owl:cardinality": "one",
                "oneOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "tripleObjectQualifier": {
                "description": "Contextual or qualifying information about the object of the assertion, observation, or inference. For example, a chemical entity object may be qualified by its form (e.g. abundance or activity of a gene product), or a phenotypic feature object may be qualified by its severity, onset, or frequency in the context of a given disease association. Corresponds to object-level qualifiers in RDF-star annotations or RDF literal metadata.",
                "owl:cardinality": "many",
                "anyOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/propertyvalue"
                    }
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/definedterm"
                    }
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "tripleSubjectQualifier": {
                "description": "Contextual or qualifying information about the subject of the assertion, observation, or inference. For example, a disease subject may be qualified by the anatomical location or cell type in which it manifests. Corresponds to subject-level qualifiers in RDF-star annotations or named graph metadata.",
                "owl:cardinality": "many",
                "anyOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/propertyvalue"
                    }
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/definedterm"
                    }
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "triplePredicateQualifier": {
                "description": "Contextual or qualifying information about the predicate of the assertion, observation, or inference. For example, a 'gene associated with disease' predicate may be qualified by the association type (e.g. causal vs. correlated), the direction of effect (e.g. gain-of-function vs. loss-of-function), or the knowledge source (e.g. curated vs. inferred). Corresponds to predicate-level qualifiers in RDF-star annotations or property path metadata.",
                "owl:cardinality": "many",
                "anyOf": [
                  {
                    "$ref": "#/definitions/propertyvalue"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/propertyvalue"
                    }
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/definedterm"
                    }
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "owl:cardinality": "one",
                "type": "string"
              }
            },
            "required": [
              "tripleObject",
              "triplePredicate",
              "tripleSubject"
            ],
            "recommended": [
              "isSymmetric",
              "inversePredicate",
              "tripleObjectQualifier",
              "tripleSubjectQualifier",
              "triplePredicateQualifier"
            ],
            "optional": [
              "name"
            ]
              
          },
