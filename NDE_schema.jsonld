          "quantitativevalue": {
            "@type": "QuantitativeValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              }
            },
            "required" : ["unitText"],
            "recommended": ["value"],
            "optional": ["maxValue","minValue"]
          },
          "propertyvalue": {
            "@type": "PropertyValue",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "value": {
                "description": "A numeric value for the property",
                "abstract": "A number or numeric measurement recorded for a property",
                "alternateName": "Value",
                "type": "number"
              },
              "maxValue": {
                "description": "An estimated maximum numberic value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Highest value in a range",
                "alternateName": "Maximum Value",
                "type": "number"
              },
              "minValue": {
                "description": "An estimated minumum numeric value if the actual value is not known. Ignore if actual numeric value is known.",
                "abstract": "Lowest value in a range",
                "alternateName": "Minimum Value",
                "type": "number"
              },
              "unitText": {
                "description": "A unit associated with the value. E.g.- 'records' for the number of records in a database.",
                "abstract": "The thing that is being counted or measured",
                "alternateName": "Unit",
                "type": "string"
              },
              "propertyID": {
                "description": "A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be (1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3) a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry). Standards bodies should promote a standard prefix for the identifiers of properties from their standards.",
                "abstract": "Identifier for the property being described",
                "alternateName": "Property ID",
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required" : ["unitText"],
            "recommended": ["value","propertyID"],
            "optional": ["maxValue","minValue"]
          },
          "coordinates": {
            "@type": "GeoCoordinates",
            "description": "The geographic coordinates of a place",
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              },
              "elevation": {
                "type": "string"
              }
            }
          },
          "adminarea": {
            "@type": "AdministrativeArea",
            "type": "object",
            "description": "Location information",
            "properties": {
              "administrativeType": {
                "description": "the type of administrative area, such as country, state, county, or city",
                "abstract": "The type of geographic area defined by how it is administered or governed",
                "alternateName": "Administrative Type",
                "disambiguatingDescription": "Province: a large administrative division of a country, often with its own regional government; District: a subdivision of a province, state, or region used for local administration; Chiefdom: a territory ruled by a traditional chief, common in parts of West Africa; Village: a small rural community, usually smaller than a town; City: a large, densely populated urban area with its own local government; Country: a sovereign nation with its own government and defined borders; Prefecture: an administrative division headed by a prefect, used in places like Japan, France, and Guinea; Sub-prefecture: a smaller administrative unit within a prefecture; Clan: a group of families who share a common ancestor or heritage; Federal Capital Territory: a special area, such as Abuja in Nigeria, that serves as the national capital and isn’t part of any state; State: a self-governing region within a federal country, such as Nigeria or the United States; Local Government Area: the third tier of government in Nigeria, similar to a county or municipality; Ward: the smallest electoral or administrative unit within a local government area or city; Region: a broad area defined by geography, culture, or administration, often larger than a district; Continent: one of Earth’s seven major landmasses, such as Africa or Asia; Military installation: a facility or base used by armed forces for operations, training, or housing; Other: any location type that doesn’t fit the categories listed above.",
                "enum": ["province", "district", "chiefdom", "village", "city", "country", "prefecture", "sub-prefecture", "clan", "Federal Capital Territory", "state", "Local Government Area", "ward", "region", "continent", "military installation", "other"],
                "type": "string"
              },
              "alternateName": {
                "description": "An alias for the location",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "identifier": {
                "description": "An identifier for the location, preferably a Wikidata ID",
                "abstract": "A unique ID for the Place",
                "alternateName": "Identifier",
                "type": "string"
              },
              "locationType": {
                "description": "Categorization of how the location relates to the dataset",
                "abstract": "How the location relates to the resource",
                "alternateName": "Location Type",
                "disambiguatingDescription": "Residence: the subjects reside in the geographic area; Exposure: the subjects were exposed to a disease-causing agent in the geographic area; Collection: the data or samples were collected in the geographic area; Treatment: the subjects or samples were treated in the geographic area; Study location: the study was conducted in the geographic area; Item location: the sample or item is located in the geographic area; Other: there is a different relationship between the geographic area and the resource; Unknown: the relationship between the geographic area and the resource is not known",
                "oneOf": [
                  {
                    "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": ["residence", "exposure", "collection", "screening", "treatment", "study location", "item location", "other", "unknown"],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "name": {
                "description": "The name of the location",
                "abstract": "The full official name of the Place",
                "alternateName": "Name",
                "type": "string"
              },
              "geo": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/coordinates"
                    }
                  },
                  {
                      "$ref": "#/definitions/coordinates"
                  }
                ]
                  }
            }
          }
        }
      }
    },
    {
      "@id": "nde:ComputationalTool",
      "@type": "rdfs:Class",
      "rdfs:comment": "ComputationalTools (software, workflows, computational tools, code) contained in the NIAID Data Ecosystem. The NIAID Data Ecosystem is a secure environment to find, access and analyze immune-mediated and infectious disease data and computational tools to speed the development of diagnostics, therapeutics, and vaccines. The NIAID Data Ecosystem Discovery Portal harvests metadata from dataset repository and harmonizes them to this schema to enable easy cross-platform dataset searching and filtering.",
      "abstract": "ComputationalTools (software, workflows, computational tools, code) contained in the NIAID Data Ecosystem.",
      "rdfs:label": "ComputationalTool",
      "rdfs:subClassOf": {
        "@id": "niaid:ComputationalTool"
      },
      "schema:schemaVersion":["https://schema.org/docs/releases.html#v18.0","v2.2 - 2026.11.18"],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Add 'disambiguatingDescription' to properties with enum values to provide structured definitions of enum values. Drop 'title' from reusable Person objects, drop 'affiliation' from reusable Organization objects add 'identifier' to DataCatalog objects for 'includedInDataCatalog'. Changed marginality of 'creditText', 'infectiousAgent', 'healthCondition', 'species' from 'optional' to 'recommended'",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "citedBy": {
            "description": "Publications, datasets, or computational tools that cite the work. Examples: a publication which uses the tool on a new dataset. For the primary publication, use the 'citation' property.",
            "abstract": "Publications, datasets, tools, etc. by other researchers that cite this resource",
            "alternateName": "Cited By",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "date": {
            "description": "Date the work has changed: most recent date of dateModified, datePublished, and dateCreated.",
            "abstract": "The most recent of the date modified, date published, and date created",
            "alternateName": "Date",
            "owl:cardinality": "one",
            "format": "date",
            "type": "string"
          },
          "doi": {
            "description": "Digital object identifier (DOI) for the work, not any associated publications.",
            "abstract": "A digital object identifier (doi) for the resource",
            "alternateName": "DOI",
            "owl:cardinality": "one",
            "type": "string"
          },
          "includedInDataCatalog": {
            "description": "Data or tool catalog where the work is published; original source of the metadata.",
            "abstract": "The repository or catalog where the resource is listed",
            "alternateName": "Source",
            "$ref": "#/definitions/catalog"
          },
          "isBasisFor": {
            "description": "A computational tool which reuses the computational tool.",
            "abstract": "Other resources that are derived from the resource",
            "alternateName": "Basis For",
            "owl:cardinality": "many",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ]
          },
          "isRelatedTo": {
            "description": "Computational tools which are related to the given computational tool. These linkages are created via human curation.",
            "abstract": "Other resources connected to the resource",
            "alternateName": "Related Resources",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "isSimilarTo": {
            "description": "Datasets or computational tools which are similar to the work, based on terms in the names, descriptions, authors, measurementTechniques, infectiousAgents, healthConditions, etc.",
            "abstract": "Other resources similar to the resource",
            "alternateName": "Similar Resources",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "topicCategory": {
            "description": "The Research Topic, Domain, or Discipline of the work. This topic may be assigned by a human curator or through automated algorithms.",
            "abstract": "Research topics covered by the resource. This topic may be assigned by a human curator or through automated algorithms",
            "alternateName": "Topic Category",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/topic"
                }
              },
              {
                "$ref": "#/definitions/topic"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "infectiousAgent": {
            "description": "Infectious agent(s) / pathogen(s) which are the focus of the work (like SARS-CoV-2).",
            "abstract": "Infectious agent(s) or pathogen(s) which are the focus of the resource",
            "alternateName": "Pathogen species",
            "anyOf": [
              {
                "description": "collection of vocabulary terms defined in ontologies",
                "strict": false,
                "type": "string",
                "vocabulary": {
                  "children_of": ["http://purl.obolibrary.org/obo/NCBITaxon_10239", "http://purl.obolibrary.org/obo/NCBITaxon_2"],
                  "ontology": ["ncbitaxon"]
                }
              },
              {
                "items": {
                  "description": "collection of vocabulary terms defined in ontologies",
                  "strict": false,
                  "type": "string",
                  "vocabulary": {
                    "children_of": ["http://purl.obolibrary.org/obo/NCBITaxon_10239", "http://purl.obolibrary.org/obo/NCBITaxon_2"],
                    "ontology": ["ncbitaxon"]
                  }
                },
                "type": "array"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "healthCondition": {
            "description": "The health condition(s) /infectious disease(s) which are the focus of the work (like COVID-19, coronavirus).",
            "abstract": "Health condition(s) or infectious disease(s) which are the focus of the resource",
            "alternateName": "Health Condition",
            "anyOf": [
              {
                "description": "collection of vocabulary terms defined in ontologies",
                "strict": false,
                "type": "string",
                "vocabulary": {
                  "children_of": ["http://purl.obolibrary.org/obo/MONDO_0000001",
                                  "http://purl.obolibrary.org/obo/DOID_4",
                                  "http://purl.obolibrary.org/obo/HP_0000001",
                                  "http://purl.obolibrary.org/obo/NCIT_C7057"],
                  "ontology": ["mondo","hpo","doid","ncit"]
                }
              },
              {
                "items": {
                  "description": "collection of vocabulary terms defined in ontologies",
                  "strict": false,
                  "type": "string",
                  "vocabulary": {
                    "children_of": ["http://purl.obolibrary.org/obo/MONDO_0000001",
                                    "http://purl.obolibrary.org/obo/DOID_4",
                                    "http://purl.obolibrary.org/obo/HP_0000001",
                                    "http://purl.obolibrary.org/obo/NCIT_C7057"],
                    "ontology": ["mondo","hpo","doid","ncit"]
                  }
                },
                "type": "array"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "funding": {
            "description": "Funding that supports (sponsors) the development of this computational tool through some kind of financial contribution.",
            "abstract": "Grants or other financial support used to create or maintain the resource",
            "alternateName": "Funding",
            "oneOf": [
              {
                "type": "object",
                "@type": "MonetaryGrant",
                "description": "Funding that supports (sponsors) the development of this computational tool through some kind of financial contribution",
                "properties": {
                  "funder": {
                    "description": "An organization associated with a creator or funder of a computational tool",
                    "abstract": "Organization(s) that provided the funding",
                    "alternateName": "Funder",
                    "oneOf": [
                      {
                        "type": "object",
                        "@type": "Organization",
                        "description": "Information about a single funder",
