                  "$ref": "#/definitions/organization"
                }
              },
              {
                  "$ref": "#/definitions/organization"
              }
            ],
            "owl:cardinality": "many"
          },
          "creditText": {
            "description": "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work. For example, how a user should cite the tool.",
            "abstract": "Citation or acknowledgment text the resource asks users to include when they use it",
            "alternateName": "How to Credit",
            "type": "string",
            "owl:cardinality": "one"
          },
          "creativeWorkStatus": {
            "description": "The status of the ComputationalTool. Expected to be one of the following values: Draft (The tool is under development), Active (The tool is currently working and available), Maintenance (The tool is temporarily unavailable for maintenance), Accepting Data (The tool is Active AND Accepting submissions), Not Accepting Data (The tool is Active but is NOT Accepting submissions), Retired (The tool is no longer being maintained).",
            "abstract": "Status of the resource: Active, Accepting Data, Not Accepting Data, Maintenance, Draft, or Retired",
            "alternateName": "Status",
            "disambiguatingDescription": "Draft: Under development; Active: Currently working and available; Maintenance: Temporarily unavailable for maintenance; Accepting Data: Active AND Accepting submissions; Not Accepting Data: Active but NOT Accepting submissions; Retired: No longer being maintained",
            "type": "string",
            "enum": ["Draft", "Active", "Maintenance", "Accepting Data", "Not Accepting Data", "Retired"],
            "owl:cardinality": "one"
          }
        },
        "required": ["date", "includedInDataCatalog", "funding", "author", "description", "name"],
        "recommended": ["citedBy", "doi", "topicCategory", "codeRepository", "programmingLanguage", "applicationCategory", "applicationSubCategory", "input", "output", "featureList", "operatingSystem", "softwareRequirements", "softwareVersion", "citation", "conditionsOfAccess", "dateModified", "interactionStatistic", "license", "identifier", "creditText", "url", "infectiousAgent", "healthCondition", "species"],
        "optional": ["isBasisFor", "isRelatedTo", "isSimilarTo", "applicationSuite", "availableOnDevice", "downloadUrl", "processorRequirements", "softwareAddOn", "softwareHelp", "aggregateRating", "contributor", "creator", "dateCreated", "datePublished", "discussionUrl", "hasPart", "inLanguage", "isAccessibleForFree", "isBasedOn", "isPartOf", "keywords", "sdPublisher", "thumbnailUrl", "mainEntityOfPage", "sameAs","sourceOrganization", "creativeWorkStatus"],
        "definitions": {
          "citationobject": {
            "description": "A citation object for a resource which is cited by the dataset (ie- is a derivative of the dataset) , related to the dataset, or from which the dataset was based on (ie- is derived from).",
            "@type": "ScholarlyArticle",
            "type": "object",
            "properties": {
              "author": {
                "description": "Author(s) of the publication",
                "abstract": "Individual(s) or organization(s) who created the reference",
                "alternateName": "Author",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/person"
                    }
                  },
                  {
                      "$ref": "#/definitions/person"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/organization"
                    }
                  },
                  {
                      "$ref": "#/definitions/organization"
                  }
                ]
              },
              "abstract": {
                "description": "Abstract of the publication",
                "abstract": "A short summary of the reference",
                "alternateName": "Abstract",
                "type": "string"
              },
              "datePublished": {
                "description": "Date the article was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "description": {
                "description": "Description of the publication",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "name": {
                "description": "Title of the publication",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the citation such as a digital object identifier (DOI), PubMed ID (PMID), or PubMed Central ID (PMCID)",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "pmid": {
                "description": "A PubMed identifier (PMID) of the referenced publication",
                "abstract": "PubMed identifier (PMID) of the publication",
                "alternateName": "PubMed ID",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced publication",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "issueNumber": {
                "description": "Issue number where the article appears",
                "abstract": "Journal issue in which the publication appeared",
                "alternateName": "Issue Number",
                "type": "string"
              },
              "journalName": {
                "description": "Journal where the article appears",
                "abstract": "Name of the journal in which the reference appeared",
                "alternateName": "Journal",
                "type": "string"
              },
              "journalNameAbbrev": {
                "description": "Abbreviated journal name where the article appears",
                "abstract": "Abbreviation of the name of the journal in which the reference appeared",
                "alternateName": "Journal Abbreviation",
                "type": "string"
              },
              "pagination": {
                "description": "Page numbers in the journal where the article appears",
                "abstract": "Page range of the publication",
                "alternateName": "Pages",
                "type": "string"
              },
              "url": {
                "description": "The url of the article",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "volumeNumber": {
                "description": "Volume of the journal where the article appears",
                "abstract": "Volume of the journal where the publication appeared",
                "alternateName": "Volume Number",
                "type": "string"
              },
              "citation": {
                "description": "The bibliographic citation string for the article as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "datePublished", "doi", "identifier", "journalName", "pmid", "url"],
            "optional": ["abstract", "citation", "description", "issueNumber", "journalNameAbbrev", "pagination", "volumeNumber"]
          },
          "catalog": {
            "@type": "DataCatalog",
            "description": "Data or tool catalog",
            "type": "object",
            "properties": {
              "name": {
                "description": "Data or tool catalog name",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier for the catalog within the Discovery Portal",
                "abstract": "The identifier of the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "Link to data or tool catalog",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "versionDate": {
                "description": "date the metadata was harvested from the catalog",
                "abstract": "Date the version was released",
                "alternateName": "Version Date",
                "type": "string",
                "format": "date"
              },
              "archivedAt": {
                "description": "The url(s) of one or more datasets, tools, resources or other items listed in a DataCatalog or ResourceCatalog",
                "abstract": "Link to the resource metadata record at the original source",
                "alternateName": "Source URL", 
                "oneOf": [
                  {
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "type": "array"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              }
            },
            "required": ["name", "url"],
            "recommended": ["identifier", "versionDate", "archivedAt"]
          },
          "creativework": {
            "description": "A resource",
            "@type": "CreativeWork",
            "type": "object",
            "properties": {
              "author": {
                "description": "Author(s) of the referenced work",
                "abstract": "Individual(s) or organization(s) who created the reference",
                "alternateName": "Author",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/person"
                    }
                  },
                  {
                      "$ref": "#/definitions/person"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/organization"
                    }
                  },
                  {
                      "$ref": "#/definitions/organization"
                  }
                ]
              },
              "abstract": {
                "description": "Abstract of the referenced work",
                "abstract": "A short summary of the reference",
                "alternateName": "Abstract",
                "type": "string"
              },
              "additionalType": {
                "description": "Additional type of the referenced work, such as a Sample, Run, Experiment, etc.",
                "abstract": "More classifications for the resource or reference",
                "alternativeName": "Also Classified As",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "format": "uri",
                          "type": "string"
                        }
                      },
                      "required": ["name"],
                      "recommended": ["url"],
                      "type": "object",
                      "@type": "DefinedTerm"                
                    },
                    "type": "array"
                  },
                  {
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "format": "uri",
                        "type": "string"
                      }
                    },
                    "required": ["name"],
                    "recommended": ["url"],
                    "type": "object",
                    "@type": "DefinedTerm"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }    
                ]
              },
              "datePublished": {
                "description": "Date the referenced work was published",
                "abstract": "Date the reference was first made publicly available",
                "alternateName": "Date Published",
                "format": "date",
                "type": "string"
              },
              "description": {
                "description": "Description of the referenced work",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "hasPart": {
                "description": "A portion of the work",
                "abstract": "Part(s) that make up the resource",
                "alternateName": "Component",
                "oneOf": [
                  {
                    "$ref": "#/definitions/citationobject"
                  }
                ]
              },
              "includedInDataCatalog": {
                "description": "Data or tool catalog which houses the work",
                "abstract": "The repository or catalog where the resource is listed",
                "alternateName": "Source",
                "oneOf": [
                  {
                    "$ref": "#/definitions/catalog"
                  }
                ]
              },
              "name": {
                "description": "Name or title",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the work",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "relationship": {
                "description": "How the works are related",
                "abstract": "How the resource is related to another resource",
                "alternateName": "Relationship",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced work",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "url": {
                "description": "The url of the work",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "citation": {
                "description": "The bibliographic citation for the referenced work as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "datePublished", "doi", "identifier", "includedInDataCatalog", "relationship", "url"],
            "optional": ["abstract", "citation", "description", "hasPart"]
          },
          "topic": {
            "description": "Topic assigned to the work.",
            "type": "string",
            "vocabulary": {
              "ontology": ["edam"],
              "children_of": ["http://edamontology.org/topic_0003"]
            },
            "strict": true
          },
          "organization": {
            "@type": "Organization",
            "description": "Reusable organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the oorganization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier"],
            "optional": ["alternateName", "email", "parentOrganization", "role", "url"],
            "type": "object"
          },
          "researchproject": {
            "@type": "ResearchProject",
            "description": "a type of organization definition",
            "properties": {
              "alternateName": {
                "description": "Alias of the name",
                "abstract": "Other names",
                "alternateName": "Alternate Name",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "name": {
                "description": "Name of the organization",
                "abstract": "The full official name of the organization",
                "alternateName": "Name",
                "type": "string"
              },
              "parentOrganization": {
                "description": "Name of the parent organization. For instance, the parentOrganization of NIAID is the National Institutes of health (NIH)",
                "abstract": "The larger organization to which the organization belongs",
                "alternateName": "Parent Organization",
                "type": "string"
              },
              "email": {
                "description": "Email address of the organization",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the organization",
                "abstract": "A unique ID for the organization",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "What role the organization played in creating the dataset",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the organization",
                "abstract": "The main website URL of the organization",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["identifier", "url", "parentOrganization"],
            "optional": ["alternateName", "email", "role"],
            "type": "object"
          },
          "person": {
            "@type": "Person",
            "description": "Reusable person definition",
            "properties": {
              "affiliation": {
                "abstract": "The person's institutional or organizational affiliation",
                "alternateName": "Affiliation",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name of the affiliation, such as a university",
                    "abstract": "The full official name of the affiliation",
                    "alternateName": "Name",
                    "type": "string"
                  },
                  "identifier": {
                    "description": "An identifier for the affiliation",
                    "abstract": "ID of the affiliation",
                    "alternateName": "Identifier",
                    "type": "string"
                  },
                  "url": {
                    "description": "URL of the affiliation",
                    "abstract": "The main website URL of the affiliation",
                    "alternateName": "URL",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["name"],
                "optional": ["identifier", "url"]
              },
              "name": {
                "description": "Name of the person",
                "abstract": "The name of the person",
                "alternateName": "Name",
                "type": "string"
              },
              "email": {
                "description": "Email address of the person",
                "abstract": "Contact email address for the person or organization",
                "alternateName": "Email",
                "type": "string"
              },
              "familyName": {
                "description": "Family name (surname) of the person",
                "abstract": "An individual's family name or surname",
                "alternateName": "Last Name",
                "type": "string"
              },
              "givenName": {
                "description": "Given (first) name of the person",
                "abstract": "An individual's given name",
                "alternateName": "First Name",
                "type": "string"
              },
              "identifier": {
                "description": "Unique identifier of the person, like an ORCID ID",
                "abstract": "A unique ID for the person",
                "alternateName": "Identifier",
                "type": "string"
              },
              "role": {
                "description": "Role the person played in creating the computational tool",
                "abstract": "The role played by an individual or organization",
                "alternateName": "Role",
                "type": "string"
              },
              "url": {
                "description": "Link to the homepage or other web content describing the person",
                "abstract": "The main website URL of the person",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["familyName", "givenName", "identifier"],
            "optional": ["affiliation", "email", "role", "url"],
            "type": "object"
          },
          "definedterm": {
            "@type": "DefinedTerm",
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the item.",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "owl:cardinality": "one",
                "type": "string"
              },
              "identifier": {
                "description": "The identifier property represents any kind of identifier for any kind of Thing, such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See background notes for more details.",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "owl:cardinality": "one",
                "type": "string"           
              },
              "url": {
                "description": "URL of the item.",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "owl:cardinality": "one",
                "type": "string",
                "format": "uri"
              },
              "curatedBy": {
                "description": "The person, organization, or catalog that curated this DefinedTerm for the metadata property",
                "abstract": "Human(s) or automated algorithm(s) that curated the resource or its metadata",
                "alternateName": "Curated By",
                "anyOf": [
                  {
                    "$ref": "#/definitions/person"
                  },
                  {
                    "$ref": "#/definitions/organization"
                  },
                  {
                    "$ref": "#/definitions/catalog"
                  },
                  {
                    "$ref": "#/definitions/researchproject"
                  },
                  {
                    "$ref": "#/definitions/softwareapplication"
                  }
                ]
              },
              "termCode": {
                "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
                "abstract": "The code for the term in its source ontology",
                "alternateName": "Term Code",
                "type": "string"
              },
              "description": {
                "description": "A description of the item.",
                "abstract" : "An overview of the item",
                "alternateName": "Description",
                "type": "string"
              },
              "inDefinedTermSet": {
                "description": "A DefinedTermSet that contains this term.",
                "abstract": "Ontology or controlled vocabulary from which the term comes",
                "alternateName": "Ontology",
                "type": "string"
              },
              "originalName": {
                "description": "The original name of the item, before any metadata standardization/normalization",
                "abstract": "The term as it appeared before standardization",
                "alternateName": "Original Name",
                "type": "string"
              },
              "isCurated": {
                "description": "A boolean indicator describing whether or not this DefinedTerm was curated as the value of a property.",
                "abstract": "Whether the information was reviewed by a curator",
                "alternateName": "Curated",
                "type": "boolean"
              }
            },
            "required": []  
          },
          "softwareapplication": {
            "@type": "SoftwareApplication",
            "description": "Reusable software or algorithm definition",
            "properties": {
              "name": {
                "description": "name of the software, computational tool, or algorithm.",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "dateModified": {
                "description": "date the software, computational tool, or algorithm was run",
                "abstract": "Date the tool was most run",
                "alternateName": "Date Modified",
                "type": "string",
                "format": "date"
              },
              "url": {
                "description": "url of the software, computational tool, or algorithm",
                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["url"],
            "optional": ["dateModified"],
            "type": "object"
          },
          "formalparameter": {
            "@type": "FormalParameter",
            "description": "Reusable input or output parameter definition",
            "properties": {
              "name": {
                "type": "string",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "description": "Name of the software input"
              },
              "identifier": {
                "description": "An ontology identifier or url of the software input our output",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                ]
              },
              "description": {
                "type": "string",
                "description": "Description of the software input or output",
                "abstract" : "An overview of the parameter",
                "alternateName": "Description"
              },
              "encodingFormat": {
                "description": "File type of the software input our output",
                "abstract": "The file format/encoding of the download",
                "alternateName": "File Format",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/definedterm"
                    }
                  },
                  {
                      "$ref": "#/definitions/definedterm"
                  },
                  {
                    "description": "data type of the records included in this collection.",
                    "type": "string",
                    "vocabulary": {
                      "ontology": ["edam"],
                      "children_of": ["http://edamontology.org/format_1915"]
                    },
                    "strict": false
                  },
                  {
                    "type": "array",
                    "items": {
                      "description": "data type of the records included in this collection.",
                      "type": "string",
                      "vocabulary": {
                        "ontology": ["edam"],
                        "children_of": ["http://edamontology.org/format_1915"]
                      },
                      "strict": false
                    }
                  }
                ]
              }
            },
            "required": ["name"],
            "recommended": ["encodingFormat"]
          }
        }
      }
    },
    {
      "@id": "nde:ResourceCatalog",
      "@type": "rdfs:Class",
      "rdfs:comment": "ResourceCatalogs (collections of scientific information or research outputs) contained in the NIAID Data Ecosystem. Resource catalogs include databases, repositories, knowledge bases, citation indices, software indices, browser-based data portals (web portals), etc. The NIAID Data Ecosystem is an environment to find and access and infectious and immune-mediated disease data, resources and computational tools to speed the development of diagnostics, therapeutics, and vaccines. The NIAID Data Ecosystem Discovery Portal harvests metadata from dataset repository and harmonizes them to this schema to enable easy cross-platform dataset searching and filtering.",
      "abstract": "ResourceCatalogs (collections of scientific information or research outputs) contained in the NIAID Data Ecosystem. Resource catalogs include databases, repositories, knowledge bases, citation indices, software indices, browser-based data portals (web portals), etc.",
      "rdfs:label": "ResourceCatalog",
      "rdfs:subClassOf": {
        "@id": "schema:Collection"
      },
      "schema:schemaVersion":["https://schema.org/docs/releases.html#v18.0","v2.6 - 2026.11.18"],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Add 'disambiguatingDescription' to properties with enum values to provide structured definitions of enum values. Add 'contentSize' to DataDownload object for distribution, drop 'title' from reusable Person objects, drop 'affiliation' from reusable Organization objects, add 'geo' to 'AdministrativeArea' objects, add 'identifier' to DataCatalog objects for 'includedInDataCatalog'. Replaced 'itemReviewed' with 'reviewAspect' in AggregateRating objects. Changed marginality of 'creativeWorkStatus' and 'creditText' from 'optional' to 'recommended'.  Add 'publishingPrinciples' to enable information on Data Submission Standards.",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "about": {
            "description": "The entity type or class encapsulated by the records in this resource. For example, if a repository has a record on CDK2, and metadata about the genetic sequence, epigentic annotation, gene locus, etc-- the entity type would be Gene, and the resource contains data 'about' Genes. These should be formatted as DefinedTerm objects (mapped to ontology terms) for easier standardization.",
            "abstract": "The (schema.org) types or classes of records included in the resource",
            "alternateName": "Content Type",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"    
          },
          "citedBy": {
            "description": "Publications, datasets, or computational tools that cite the work. Examples: a publication which uses information or content of the resource catalog for secondary analysis, or a computational tool which relies on the content of the resource catalog. For the primary citation, use the 'citation' field.",
            "abstract": "Publications, datasets, tools, etc. by other researchers that cite this resource",
            "alternateName": "Cited By",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "date": {
            "description": "Date the work has changed: most recent date of dateModified, datePublished, and dateCreated.",
            "abstract": "The most recent of the date modified, date published, and date created",
            "alternateName": "Date",
            "format": "date",
            "type": "string",
            "owl:cardinality": "one"
          },
          "doi": {
            "description": "Digital Object Identifier (DOI) for the work, not any associated publications.",
            "abstract": "A digital object identifier (doi) for the resource",
            "alternateName": "DOI",
            "type": "string",
            "owl:cardinality": "one"
          },
          "isRelatedTo": {
            "description": "Resources which are related to the given resource catalog. These linkages are created via human curation.",
            "abstract": "Other resources connected to the resource",
            "alternateName": "Related Resources",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "isSimilarTo": {
            "description": "Resource catalogs which are similar to the work, based on terms in the names, descriptions, authors, measurementTechniques, infectiousAgents, healthConditions, etc.",
            "abstract": "Other resources similar to the resource",
            "alternateName": "Similar Resources",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "isBasisFor": {
            "description": "A resource catalog which uses the resource catalog.",
            "abstract": "Other resources that are derived from the resource",
            "alternateName": "Basis For",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creativework"
                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "relationship": {
            "description": "How an associated work is related to the resource catalog.",
            "abstract": "How the resource is related to another resource",
            "alternateName": "Relationship",
            "type": "string",
            "owl:cardinality": "one"
          },
          "topicCategory": {
            "description": "The Research Topic, Domain, or Discipline of the work. This topic may be assigned by a human curator or through automated algorithms.",
            "abstract": "Research topics covered by the resource. This topic may be assigned by a human curator or through automated algorithms",
            "alternateName": "Topic Category",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/topic"
                }
              },
              {
                "$ref": "#/definitions/topic"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "infectiousAgent": {
            "description": "Infectious agent(s) / pathogen(s) which are the focus of the work (like SARS-CoV-2).",
            "abstract": "Infectious agent(s) or pathogen(s) which are the focus of the resource",
            "alternateName": "Pathogen species",
            "anyOf": [
              {
                "description": "collection of vocabulary terms defined in ontologies",
                "strict": false,
                "type": "string",
                "vocabulary": {
                  "children_of": ["http://purl.obolibrary.org/obo/NCBITaxon_10239", "http://purl.obolibrary.org/obo/NCBITaxon_2"],
                  "ontology": ["ncbitaxon"]
                }
              },
              {
                "items": {
                  "description": "collection of vocabulary terms defined in ontologies",
                  "strict": false,
                  "type": "string",
                  "vocabulary": {
                    "children_of": ["http://purl.obolibrary.org/obo/NCBITaxon_10239", "http://purl.obolibrary.org/obo/NCBITaxon_2"],
                    "ontology": ["ncbitaxon"]
                  }
                },
                "type": "array"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "healthCondition": {
            "description": "The health condition(s) /infectious disease(s) which are the focus of the work (like COVID-19, coronavirus).",
            "abstract": "Health condition(s) or infectious disease(s) which are the focus of the resource",
            "alternateName": "Health Condition",
            "anyOf": [
              {
                "description": "collection of vocabulary terms defined in ontologies",
                "strict": false,
                "type": "string",
                "vocabulary": {
                  "children_of": ["http://purl.obolibrary.org/obo/MONDO_0000001",
                                  "http://purl.obolibrary.org/obo/DOID_4",
                                  "http://purl.obolibrary.org/obo/HP_0000001",
                                  "http://purl.obolibrary.org/obo/NCIT_C7057"],
                  "ontology": ["mondo","hpo","doid","ncit"]
                }
              },
              {
                "items": {
                  "description": "collection of vocabulary terms defined in ontologies",
                  "strict": false,
                  "type": "string",
                  "vocabulary": {
                    "children_of": ["http://purl.obolibrary.org/obo/MONDO_0000001",
                                    "http://purl.obolibrary.org/obo/DOID_4",
                                    "http://purl.obolibrary.org/obo/HP_0000001",
                                    "http://purl.obolibrary.org/obo/NCIT_C7057"],
                    "ontology": ["mondo","hpo","doid","ncit"]
                  }
                },
                "type": "array"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              },
              {
                "$ref": "#/definitions/definedterm"
              }
            ],
            "owl:cardinality": "many"
          },
          "funding": {
            "description": "Funding that supports (sponsors) the creation or maintenance of the resource catalog through some kind of financial contribution.",
            "abstract": "Grants or other financial support used to create or maintain the resource",
            "alternateName": "Funding",
            "oneOf": [
              {
                "type": "object",
                "@type": "MonetaryGrant",
                "description": "Funding that supports (sponsors) the creation or maintenance of the resource catalog through some kind of financial contribution",
                "properties": {
                  "funder": {
                    "description": "An organization associated with a creator or funder of a resource catalog",
                    "abstract": "Organization(s) that provided the funding",
                    "alternateName": "Funder",
                    "oneOf": [
                      {
                        "type": "object",
                        "@type": "Organization",
                        "description": "Information about a single funder",
                        "properties": {
                          "name": {
                            "type": "string",
                            "abstract": "The full official name of the organization",
                            "alternateName": "Name",
                            "description": "An organization associated with a creator or funder of a resource catalog"
                          },
                          "parentOrganization": {
                            "type": "string",
                            "abstract": "The larger organization to which the organization belongs",
                            "alternateName": "Parent Organization",
                            "description": "name of the parent funding organization"
                          }
                        },
                        "required": [
