                }
              },
              {
                  "$ref": "#/definitions/creativework"
              }
            ],
            "owl:cardinality": "many"
          },
          "isPartOf": {
            "description": "Indicates a broader study, project, or collection the work is part of.",
            "abstract": "Larger project, collection, or other resource to which the resource belongs",
            "alternateName": "Part Of",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/citationobject"
                }
              },
              {
                "$ref": "#/definitions/citationobject"
              },
              {
                "type": "array",
                "items": {
