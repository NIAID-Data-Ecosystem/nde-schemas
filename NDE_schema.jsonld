              },
              "relationship": {
                "description": "How the works are related",
                "abstract": "How the resource is related to another resource",
                "alternateName": "Relationship",
                "type": "string"
              },
              "doi": {
                "description": "A digital object identifier (DOI) of the referenced work",
                "abstract": "A digital object identifier (doi) for the reference",
                "alternateName": "DOI",
                "type": "string"
              },
              "url": {
                "description": "The url of the work",
                "abstract": "The main website URL of the reference",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "citation": {
                "description": "The bibliographic citation for the referenced work as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["additionalType", "datePublished", "doi", "identifier", "includedInDataCatalog", "relationship", "url"],
            "optional": ["abstract", "citation", "description"]
          },
          "thing": {
            "description": "A thing",
            "@type": "Thing",
            "type": "object",
            "properties": {
              "description": {
                "description": "Description of the referenced work",
                "abstract" : "An overview of the reference",
                "alternateName": "Description",
                "type": "string"
              },
              "name": {
                "description": "Name or title",
                "abstract": "The full official name of the resource",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the work",
                "abstract": "A unique ID for the resource",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "The url of the work",
                "abstract": "The main website URL of the reference",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["description", "identifier", "url"]
          },
          "propobject": {
            "description": "A thing",
            "@type": "Property",
            "type": "object",
            "properties": {
              "description": {
                "description": "Description of the property",
                "abstract" : "An overview of the property",
                "alternateName": "Description",
                "type": "string"
              },
              "name": {
                "description": "Name of the property",
                "abstract": "The full official name of the property",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the property",
                "abstract": "A unique ID for the property",
                "alternateName": "Identifier",
                "type": "string"
              },
              "url": {
                "description": "The url of the property",
                "abstract": "The main website URL of the property",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "recommended": ["description", "identifier", "url"]
          },
          "statvar":  {
            "@type": "StatisticalVariable",
            "description": "A numeric value and unit for a property with potentially different units",
            "type": "object",
            "properties": {
              "name": {
                "description": "Name of the item",
                "abstract": "The full official name of the item",
                "alternateName": "Name",
                "type": "string"
              },
              "identifier": {
                "description": "An identifier associated with the item",
                "abstract": "A unique ID for the item",
                "alternateName": "Identifier",
                "type": "string"
              },
              "statType": {
                "description": "Indicates the kind of statistic represented by a StatisticalVariable, e.g. mean, count etc. The value of statType is a property, either from within Schema.org (e.g. median, marginOfError, maxValue, minValue) or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. ",
                "abstract": "The kind of statistic reported",
                "alternateName": "Statistic Type",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              },
              "populationType": {
                "description": "Indicates the populationType common to all members of a StatisticalPopulation or all cases within the scope of a StatisticalVariable.",
                "abstract": "Type of entities that make up the population the inference describes",
                "alternateName": "Population Type",
                "oneOf": [
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "$ref": "#/definitions/thing"
                    }
                ]
              },
              "constraintProperty": {
                "description": "Indicates a property used as a constraint. For example, in the definition of a StatisticalVariable. The value is a property, either from within Schema.org or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. ",
                "anyOf": [
                  {
                    "$ref": "#/definitions/propobject"
                  },
                  {
                    "$ref": "#/definitions/definedterm"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/propobject"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/definedterm"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                ]
              }
            },
            "required": ["name"],
            "recommended": ["statType", "identifier", "populationType","constraintProperty"]
          }
        }
      }
    },
    {
      "@id": "nde:observationType",
      "@type": "rdf:Property",
      "rdfs:comment": "One or more categories of the inference. The categories may reflect specific triple patterns or motifs. For example, gene x is upregulated in disease y OR gene x is differentiall expressed in disease y.",
      "rdfs:label": "observationType",
      "schema:domainIncludes": {
        "@id": "nde:Inference"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        },
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:DefinedTerm"
        }
      ]
    },
    {
      "@id": "nde:semanticMapping",
      "@type": "rdf:Property",
      "rdfs:comment": "An explicit mapping of the inference to a SemanticTriple format. Schema.org classes are structured such that each property is a predicate, each Class is the 'subject' and the value of each property is the object. This can be confusing when the class (like the Inference type) can potentially be similar to a semantic triple on its own. While potentially redundant, this property enables explicit and unambiguous mapping of the inference to a semantic triple for increased interpretability.",
      "rdfs:label": "semanticMapping",
      "schema:domainIncludes": {
        "@id": "nde:Inference"
      },
      "schema:rangeIncludes": [
        {
          "@id": "nde:SemanticTriple"
        }
      ]
    },
    {
      "@id": "nde:analyticalMethod",
      "@type": "rdf:Property",
      "rdfs:comment": "One or more analytical methods or techniques used to create the inference from the data",
      "rdfs:label": "analyticalMethod",
      "schema:domainIncludes": {
        "@id": "nde:Inference"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        },
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:DefinedTerm"
        }
      ]
    },
    {
      "@id": "nde:isSymmetric",
      "@type": "rdf:Property",
      "rdfs:comment": "A boolean indicating whether the triple's predicate asserts a symmetric relationship — that is, if A relates to B, then B relates to A by the same predicate. For example, biolink:correlated_with is symmetric, while biolink:regulates is not. Corresponds to owl:SymmetricProperty in OWL and symmetric: true in the Biolink Model.",
      "rdfs:label": "isSymmetric",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Boolean"
      }
    },
    {
      "@id": "nde:inversePredicate",
      "@type": "rdf:Property",
      "rdfs:comment": "The predicate that expresses the inverse of this triple's relationship. The predicate which would be used if subject and object were swapped. Only meaningful when isSymmetric is false. For example, the inverse of biolink:regulates is biolink:regulated_by. Corresponds to owl:inverseOf in OWL and the inverse: slot on predicate definitions in the Biolink Model.",
      "rdfs:label": "inversePredicate",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:tripleObject",
      "@type": "rdf:Property",
      "rdfs:comment": "The value or entity the predicate points to (corresponding to the RDF object). ",
      "rdfs:label": "tripleObject",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:triplePredicate",
      "@type": "rdf:Property",
      "rdfs:comment": "The relationship being asserted, observed, inferred, between the subject and the object (corresponding to the RDF predicate)",
      "rdfs:label": "triplePredicate",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:tripleSubject",
      "@type": "rdf:Property",
      "rdfs:comment": "The entity the assertion, observation, or inference is about (corresponding to the RDF subject). ",
      "rdfs:label": "tripleSubject",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:tripleObjectQualifier",
      "@type": "rdf:Property",
      "rdfs:comment": "Contextual or qualifying information about the object of the assertion, observation, or inference. For example, a chemical entity object may be qualified by its form (e.g. abundance or activity of a gene product), or a phenotypic feature object may be qualified by its severity, onset, or frequency in the context of a given disease association. Corresponds to object-level qualifiers in RDF-star annotations or RDF literal metadata.",
      "rdfs:label": "tripleObjectQualifier",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:tripleSubjectQualifier",
      "@type": "rdf:Property",
      "rdfs:comment": "Contextual or qualifying information about the subject of the assertion, observation, or inference. For example, a disease subject may be qualified by the anatomical location or cell type in which it manifests. Corresponds to subject-level qualifiers in RDF-star annotations or named graph metadata.",
      "rdfs:label": "tripleSubjectQualifier",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:Text"
        },
        {
          "@id": "schema:PropertyValue"
        }
      ]
    },
    {
      "@id": "nde:triplePredicateQualifier",
      "@type": "rdf:Property",
      "rdfs:comment": "Contextual or qualifying information about the predicate of the assertion, observation, or inference. For example, a 'gene associated with disease' predicate may be qualified by the association type (e.g. causal vs. correlated), the direction of effect (e.g. gain-of-function vs. loss-of-function), or the knowledge source (e.g. curated vs. inferred). Corresponds to predicate-level qualifiers in RDF-star annotations or property path metadata.",
      "rdfs:label": "triplePredicateQualifier",
      "schema:domainIncludes": {
        "@id": "nde:SemanticTriple"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "nde:citedBy",
      "@type": "rdf:Property",
      "rdfs:comment": "Publications that cite the dataset, resource/resource catalog or computational tool. Examples: a publication which reuses the dataset in a secondary analysis, a dataset which extends the existing dataset, or a computational tool which relies on the dataset.",
