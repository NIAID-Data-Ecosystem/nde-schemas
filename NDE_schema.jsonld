                "abstract": "Biological sex of the individual from which the sample was collected",
                "alternateName": "Sex",
                "anyOf": [
                  {
                    "description": "collection of vocabulary terms defined in ontologies",
                    "strict": false,
                    "type": "string",
                    "vocabulary": {
                      "children_of": ["http://purl.obolibrary.org/obo/PATO_0000047"],
                      "ontology": ["PATO"]
                    }
                  },
                  {
