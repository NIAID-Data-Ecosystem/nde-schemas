    {
      "@id": "nde:Sample",
      "@type": "rdfs:Class",
      "rdfs:comment": "Samples contained in the NIAID Data Ecosystem. A Sample is a material entity taken from a larger source, system, or environment, collected for the purpose of analysis, testing, identification, or demonstration. The NIAID Data Ecosystem Discovery Portal harvests metadata from repositories and harmonizes them to this schema to enable easy cross-platform sample searching and filtering.",
      "abstract": "Samples contained in the NIAID Data Ecosystem. A sample is a material entity taken from a larger source.",
      "rdfs:label": "Sample",
      "rdfs:subClassOf": [
        {
          "@id": "bioschemastypesdrafts:BioSample"
        },
        {
          "@id": "schema:CreativeWork"
        }
      ],
      "schema:schemaVersion":["https://schema.org/docs/releases.html#v18.0","v0.9 - 2026.11.18"],
      "dct:provenance":"Changes since previous version: Add 'abstract' and 'alternateName' to every property to include definitions and labels for UI. Add 'disambiguatingDescription' to properties with enum values to provide structured definitions of enum values. Drop 'title' from reusable Person objects, drop 'affiliation' from reusable Organization objects, add 'geo' to 'AdministrativeArea' objects, add 'identifier' to DataCatalog objects for 'includedInDataCatalog'. Replaced 'itemReviewed' with 'reviewAspect' in AggregateRating objects. Changed marginality of 'creativeWorkStatus' and 'creditText' from 'optional' to 'recommended'. Updated 'locationType' enum values for 'AdministrativeArea' object to allow for coverage of 'itemLocation' and 'locationOfOrigin' so that 'spatialCoverage' could be used instead and dropped 'itemLocation' and 'locationOfOrigin'.",
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "description": "Sample name.",
            "abstract": "The full official name of the resource",
