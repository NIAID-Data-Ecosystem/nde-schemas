                "abstract": "The main website URL of the resource",
                "alternateName": "URL",
                "type": "string",
                "format": "uri"
              },
              "citation": {
                "description": "The bibliographic citation for the referenced work as is provided",
                "abstract": "The bibliographic citation string for the article as is provided",
                "alternateName": "Citation Text",
                "type": "string"
              }
            },
            "required": ["name"],
            "recommended": ["author", "additionalType", "datePublished", "doi", "identifier", "includedInDataCatalog", "relationship", "url"],
